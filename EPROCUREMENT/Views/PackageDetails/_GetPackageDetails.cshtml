@model IEnumerable<EPROCUREMENT.ViewModel.PackageDetailsViewModel>

@{
    Layout = null;
}

 <table class="table table-striped" id="detailstble">
  <thead>
            <tr>
                                                             <th>Chapter Name</th>
                                                             <th>Start Date</th>
                                                              <th>End Date</th>
                                                             <th>File Name</th>
                                                             <th>Comments</th>
                                                            @*  <th>Update</th>
                                                            <th>Delete</th>
                                                           *@
                                                          
                                                        
                                                      </tr>
                                                </thead>

                                          <tbody>
                @foreach (var item in Model)
                {
                    <tr>
 
                                    <td>
                                        @Html.DisplayFor(modelItem => item.name)
                                    </td>

                                     <td>
                                        @Html.DisplayFor(modelItem => item.start_date)
                                    </td>


                                     <td>
                                        @Html.DisplayFor(modelItem => item.end_date)
                                    </td>


                                     <td>
                                       <a href="#">@Html.DisplayFor(modelItem => item.file_name)</a> 
                                    </td>

                                     <td>
                                        @Html.DisplayFor(modelItem => item.comments)
                                    </td>

                                     @*  <td>
                                         <a  asp-controller="PackageDetails" asp-action="GetPackageDetails" asp-route-id="@item.id"> Update</a>
                                       </td>

                                      <td>
                                         <button class='btn btn-link delete' value="@item.id" ><span class='glyphicon glyphicon-trash text-danger' style='color:red'></span></button>

                                    </td>*@


                                   

                                    
                                   


                                    
                    </tr>
                }

                                          </tbody>
                                           
                                          </table>

       <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
  <script src='https://cdnjs.cloudflare.com/ajax/libs/slim-select/1.21.0/slimselect.js'></script>
   
    <script type="text/javascript">

        $(document).on('click', '#detailstble .delete', function(e) 
{ 
     var id =$(this).val();
   
  
  if(confirm("Do you really want to delete ?"))
  {
    $.ajax({
        type:'Post',
       url: "/DeletePackage/DeletePackage",
      data: { "id": id },
      
      success:function(response){
          location.reload();
       // alert(response);
        //loadbuildings(project_id , tokenParam);                             
        
      },
      error: function (response) {
      alert(response.ex);
          }
       });
  }
  

});
    </script>