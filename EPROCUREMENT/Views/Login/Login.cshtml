@model EPROCUREMENT.Models.LoginModel;

@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="en" >
<head>
  <meta charset="UTF-8">
  <title>SIAC E-Procurement </title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/modernizr/2.8.3/modernizr.min.js" type="text/javascript"></script>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/normalize/5.0.0/normalize.min.css">

<link rel="stylesheet" type="text/css" href="~/login/style.css">

</head>
<body>
<!-- partial:index.partial.html -->
<div class="log-form">
  <h2>Login to your account</h2>
        <form method="post" asp-action="Login" asp-controller="Login" enctype="multipart/form-data">
    <input type="text" asp-for="username" placeholder="username" required />
    <input type="password" asp-for="password" placeholder="password" required />
    <button type="submit" class="btn">Login</button>

  </form>
</div><!--end log form -->
<!-- partial -->
  <script src='//cdnjs.cloudflare.com/ajax/libs/jquery/2.1.3/jquery.min.js'></script>
</body>
</html>
