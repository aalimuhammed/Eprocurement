@model EPROCUREMENT.ViewModel.ResetPasswordViewModel;

@{
	Layout = "_VLayout";
}


<body>

	<!-- Default Basic Forms Start -->
	<div class="pd-20 card-box mb-30">
		<div class="clearfix">
			<div class="pull-left">
				<h4 class="text-blue h4">Change Your Password</h4>
				<p class="mb-30"></p>
			</div>
		</div>
		<form method="POST" class="register-form" asp-action="UpdateVendorPassword" asp-controller="VendorLogin" enctype="multipart/form-data" id="resetPasswordForm" onsubmit="return validatePasswords()">
			<div class="form-group row">
				<label class="col-sm-12 col-md-2 col-form-label">Current Password</label>
				<div class="col-sm-12 col-md-10">
					<input class="form-control" type="text" placeholder="Current Password " value="@Model?.Password" readonly>
					<input class="form-control" type="hidden"  asp-for="Id"    value="@Model?.Id" hidden>
				</div>
			</div>

			<div class="form-group row">
				<label class="col-sm-12 col-md-2 col-form-label">New Password</label>
				<div class="col-sm-12 col-md-10">
					<input class="form-control" id="new_password" type="password" placeholder="New Password" required>
				</div>
			</div>

			<div class="form-group row">
				<label class="col-sm-12 col-md-2 col-form-label">Confirm New Password</label>
				<div class="col-sm-12 col-md-10">
					<input class="form-control" id="confirm_password" type="password" placeholder="Confirm New Password " asp-for="Password" required>
				</div>
			</div>
		
			<div class="mt-5 text-center"><button class="btn btn-success profile-button" type="submit" id="resetButton">Change the password</button></div>
		</form>
	</div>

</body>
<script>
	function validatePasswords() {
		var newPassword = document.getElementById('new_password').value;
		var confirmPassword = document.getElementById('confirm_password').value;

		if (newPassword !== confirmPassword) {
			alert("Passwords do not match");
			return false; // Prevent form submission
		}

		return true; // Allow form submission
	}
</script>