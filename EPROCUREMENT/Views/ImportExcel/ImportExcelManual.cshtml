@model IEnumerable<EPROCUREMENT.SapResponse.PackagesResponse>;

<style>
    .highlighted {
        background-color: #ffff99; /* or any other color */
    }
</style>


<div class="modal fade" id="alertModal" tabindex="-1" role="dialog" aria-labelledby="alertModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="alertModalLabel">Vendors Assigned</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                </div>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Vendor Name</th>
                            <th>Tax ID</th>
                        </tr>
                    </thead>
                    <tbody id="searchResultsBody"></tbody>

                </table>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="page-header">
    <div class="row">
        <div class="col-md-12 col-sm-12">
            <div class="title">
                <h4>Create Manual Packages from Excel</h4>
            </div>
        </div>
    </div>
</div>
<div class="pd-20 card-box mb-30">
    <div class="clearfix">
        <div class="pull-left">
            <h4 class="text-blue h4">Selection Criteria</h4>
        </div>
    </div>
    <form id="selectionForm">
        <div class="row">
            <div class="col-md-6">

                <div class="form-group">
                    <label>Select Project</label>
                    <select class="custom-select2 form-control" name="state" style="width: 100%; height: 38px;">
                    </select>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label>Select Industry</label>
                    <select class="custom-select2 form-control" name="state" style="width: 100%; height: 38px;">
                    </select>
                </div>
            </div>

        </div>
        <br />
        <div class="text-center">
            <!-- This div centers its content -->
            <input type="file" id="FileName" accept=".xlsx,.xls"  required/>
            <button type="button" id="btnapply" class="btn btn-primary">Upload</button>
        </div>
    </form>
</div>



<script>

    // Highlight column when a row is clicked

    $(document).ready(function () {
        // Highlight column when a row is clicked in #tblheader
        $('#tblheader').on('click', 'tr', function () {
            // Remove "highlighted" class from all rows
            $('#tblheader tr').removeClass('highlighted');
            // Add "highlighted" class to the clicked row
            $(this).addClass('highlighted');
        });
    });

    $(document).ready(function () {
        $('#btnmanualassign').on('click', function () { // When the Manual Assign button is clicked
            $('#searchTextBox').val(''); // Clear the search text box
            $('#searchResultsBody').empty();
            // fetchSearchResults(''); // Fetch search results with an empty search term
        });

        $('#searchTextBox').on('keyup', function (e) { // When a key is pressed in the search text box
            if (e.keyCode === 13) { // Check if the pressed key is Enter (key code 13)
                var searchTerm = $(this).val(); // Get the search term from the text box
                fetchSearchResults(searchTerm); // Fetch search results
            }
        });


        $(document).on('click', '#searchResultsBody button', function () {
            var selectedRow = $(this).closest('tr');
            selectedRow.hide();

            var vendorName = $(this).closest('tr').find('td:first').text(); // Get the Vendor Name from the selected row
            var taxId = $(this).closest('tr').find('td:eq(1)').text(); // Get the Tax ID from the selected row

            // Append the selected values to the designated area in the modal
            $('#selectedValues').append('<tr><td>' + vendorName + '</td><td>' + taxId + '</td><td><button class="btn btn-danger cancelBtn">Cancel</button></td></tr>');
        });

        $(document).on('click', '.cancelBtn', function () {
            var canceledRow = $(this).closest('tr'); // Get the canceled row
            canceledRow.remove(); // Remove the canceled row from the selected values table

            var vendorName = canceledRow.find('td:first').text(); // Get the Vendor Name from the canceled row
            var taxId = canceledRow.find('td:eq(1)').text(); // Get the Tax ID from the canceled row

            // Find the corresponding row in the search results table and show it
            $('#searchResultsBody tr').each(function () {
                var row = $(this);
                if (row.find('td:first').text() === vendorName && row.find('td:eq(1)').text() === taxId) {
                    row.show(); // Show the canceled row
                    return false; // Exit the loop after finding the row
                }
            });
        });

    });

    $(document).ready(function () {
        // Make an AJAX request to fetch projects
        $.ajax({
            type: 'GET', // Use GET method to fetch data
            url: '/Project/SapProjects',
            success: function (response) {
                $.each(response, function (index, project) {
                    // Append each project as an option to the select element
                    $('select[name="state"]:eq(0)').append('<option value="' + project.proj_num + '|' + project.id + '">' + project.proj_name + '</option>');
                });
            },
            error: function (xhr, textStatus, errorThrown) {
                alert('Error: ' + errorThrown);
            }
        });

        // Your existing code for handling search button click and displaying table rows goes here
    });

    $(document).ready(function () {
        // Make an AJAX request to fetch projects
        $.ajax({
            type: 'GET', // Use GET method to fetch data
            url: '/Industry/SapIndustry',
            success: function (response) {
                $.each(response, function (index, industry) {
                    // Append each project as an option to the select element
                    $('select[name="state"]:eq(1)').append('<option value="' + industry.industry_code + '|' + industry.id + '">' + industry.descr + '</option>');
                });
            },
            error: function (xhr, textStatus, errorThrown) {
                alert('Error: ' + errorThrown);
            }
        });

        // Your existing code for handling search button click and displaying table rows goes here
    });
    function validateDropdowns() {
        var projectSelected = $('select[name="state"]:eq(0)').val() !== '';
        var industrySelected = $('select[name="state"]:eq(1)').val() !== '';

        if (!projectSelected || !industrySelected) {
            alert('Please select options in both dropdown lists.');
            return false;
        }

        return true;
    }

    function validateForm() {
        var isValid = true;

        // Check if all required fields are filled in
        $('#selectionForm :input[required]').each(function () {
            if ($.trim($(this).val()) === '') {
                isValid = false;
                return false; // Exit the loop if any required field is empty
            }
        });

        return isValid;
    }

    $(document).ready(function () {
        $('#btnapply').on('click', function () { // When the search button is clicked

            if (!validateDropdowns()) {
                return;
            }

            $("input").prop('required', true);
            if (validateForm()) {
                var project = $('select[name="state"]:eq(0)').val(); // Get the selected project
                var industry = $('select[name="state"]:eq(1)').val(); // Get the selected industry

                var project_name = $('select[name="state"]:eq(0) option:selected').text();
                var industry_name = $('select[name="state"]:eq(1) option:selected').text();

                var projectId = project.split('|')[1];
                var industryId = industry.split('|')[1];
                var pack_name = project_name + "/" + industry_name;

                var formData = new FormData();

                formData.append('project_id', projectId);
                formData.append('industry_id', industryId);
                formData.append('pack_name', pack_name);
                formData.append('file', $('#FileName')[0].files[0]);


                // Make an AJAX request to your endpoint
                $.ajax({
                    type: 'POST',
                    url: '/ImportExcel/ImportExcelProcess',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response === true) {
                            alert("The file uploaded successfully");
                            location.reload();
                        }

                    },
                    error: function (xhr, textStatus, errorThrown) {
                        alert('Error: ' + errorThrown);
                    }
                });
            } else {
                alert('Please fill in all required fields.');
            }
        });
    });



    $(document).on('click', '#tblheader .btn-danger', function () {
        var rowId = $(this).data('id');
        var confirmation = confirm("Are you sure you want to cancel this package?");

        // If user confirms
        if (confirmation) {
            // Make an AJAX request to your endpoint
            $.ajax({
                type: 'POST',
                url: '/ReleasedPackages/CanceledReleased',
                data: {
                    pkg_id: rowId
                },
                success: function (response) {
                    $('#btnsearch').trigger('click');
                },
                error: function (xhr, textStatus, errorThrown) {
                    alert('Error: ' + errorThrown);
                }
            });
        }

    });

    $(document).ready(function () {
        // Other code...

        $(document).on('click', '#tblheader .btn-success', function () {
            // Get the row id from the button's data attribute
            var rowId = $(this).data('id');

            // Make an AJAX request to fetch vendors assigned to the package
            $.ajax({
                type: 'GET',
                url: '/ReleasedPackages/GetVendors',
                data: {
                    pkg_id: rowId
                },
                success: function (response) {
                    // Assuming response is an array of objects containing vendors data
                    $('#searchResultsBody').empty(); // Clear the modal body

                    // If vendors data is available, populate the modal with it
                    if (Array.isArray(response)) {
                        $.each(response, function (index, vendor) {
                            $('#searchResultsBody').append('<tr><td>' + vendor.fname + '</td><td>' + vendor.tax_id + '</td></tr>');
                        });
                    } else {
                        // If no vendors are found, display a message in the modal
                        $('#searchResultsBody').html('<tr><td colspan="2">No Vendors Assigned</td></tr>');
                    }

                    // Open the modal
                    $('#alertModal').modal('show');
                },
                error: function (xhr, textStatus, errorThrown) {
                    alert('Error: ' + errorThrown);
                }
            });
        });

        // Other code...
    });



    $(document).on('click', '#tblheader .pkgdetails', function () {
        var rowId = $(this).data('id');

        // Make an AJAX request to your endpoint
        $.ajax({
            type: 'GET',
            url: '/ReleasedPackages/GetReleasedDetails',
            data: {
                pkg_id: rowId
            },
            success: function (response) {
                // Assuming response is an array of objects containing data for each row
                $('#tbldetails').empty(); // Clear the table body
                $.each(response, function (index, row) {
                    $('#tbldetails').append(
                        '<tr>' +
                        '<td>' + row.pr_num + '</td>' +
                        '<td>' + row.line_item + '</td>' +
                        '<td>' + row.pr_date + '</td>' +
                        '<td>' + row.mtr_code + '</td>' +
                        '<td>' + row.m_grp + '</td>' +
                        '<td>' + row.mtr_desc + '</td>' +
                        '<td>' + row.mtr_long_desc + '</td>' +
                        '<td>' + row.mtr_batch + '</td>' +
                        '<td>' + row.mtr_qty + '</td>' +
                        '<td>' + row.mtr_uom + '</td>' +
                        '</tr>'
                    );
                });

            },
            error: function (xhr, textStatus, errorThrown) {
                alert('Error: ' + errorThrown);
            }
        });

    });


    $(document).on('click', '#tblheader .fileuploaded', function () {
        var rowId = $(this).data('id');
        // Create a hidden iframe
        var iframe = $('<iframe>', {
            id: 'hiddenDownloader',
            style: 'display: none'
        });
        $('body').append(iframe);

        // Set the iframe source to the download URL
        $('#hiddenDownloader').attr('src', '/ReleasedPackages/DownloadPackageFile?fileName=' + rowId);

        // Remove the iframe after download
        $('#hiddenDownloader').on('load', function () {
            $(this).remove();
        });

    });

</script>
