@model IEnumerable<EPROCUREMENT.SapResponse.PackagesResponse>;

<style>
    .highlighted {
        background-color: #ffff99; /* or any other color */
    }

    .pd-20.card-box.mb-30 {
        overflow-x: auto; /* Enable horizontal scrolling if needed */
    }

    #resulttble {
        width: 100%;
        max-width: 100%; /* Ensure table does not exceed container's width */
        table-layout: fixed; /* Prevent table from expanding to fit content */
    }

        #resulttble th,
        #resulttble td {
            white-space: nowrap; /* Prevent text wrapping */
            overflow: hidden; /* Hide overflowing content */
            text-overflow: ellipsis; /* Show ellipsis (...) for overflowed text */
        }

</style>

<h2></h2>

<div class="modal fade" id="alertModal" tabindex="-1" role="dialog" aria-labelledby="alertModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="alertModalLabel">Manual Assign</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <input type="text" id="searchTextBox" class="form-control" placeholder="Search by Namr Or Tax-ID">
                </div>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Vendor Name</th>
                            <th>Tax ID</th>
                            <th>Select</th>
                        </tr>
                    </thead>
                    <tbody id="searchResultsBody"></tbody>

                </table>

                <!-- Area to display selected values -->
                <h4>Selected Values</h4>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Vendor Name</th>
                            <th>Tax ID</th>
                            <th>Cancel</th>
                        </tr>
                    </thead>
                    <tbody id="selectedValues"></tbody>
                </table>


                <button type="button" id="btnrelease" class="btn btn-success">Release</button>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="page-header">
    <div class="row">
        <div class="col-md-12 col-sm-12">
            <div class="title">
                <h4>All Applied Vendors</h4>
            </div>
        </div>
    </div>
</div>

<div class="pd-20 card-box mb-30">
    <div class="clearfix">
        <div class="pull-left">
            <h4 class="text-blue h4">Selection Criteria</h4>
        </div>
    </div>
    <form>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Select Project</label>
                    <select class="custom-select2 form-control" name="state" style="width: 100%; height: 38px;">
                    </select>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label>Select Industry</label>
                    <select class="custom-select2 form-control" name="state" style="width: 100%; height: 38px;">
                    </select>
                </div>
            </div>

        </div>

        <br />
        <div class="text-center">
            <!-- This div centers its content -->
            <button type="button" id="btnsearch" class="btn btn-primary">Search</button>
        </div>
    </form>
</div>


<div class="pd-20 card-box mb-30">
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Package Name</th>
            </tr>
        </thead>
        <tbody id="pkgtble">
        </tbody>
    </table>
</div>



<div class="clearfix mb-20">
    <div class="pull-left">
        <h4 class="text-blue h4">Actions</h4>
    </div>
    <div class="pull-right">
        <button type="button" id="exporttoExcl" class="btn btn-success">Export To Excel</button>
    </div>
</div>

<div class="pd-20 card-box mb-30">
    <table class="table" id="resulttble">
    </table>
</div>


<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.0/xlsx.full.min.js"></script>

<script>
    $(document).ready(function () {
        // Make an AJAX request to fetch projects
        $.ajax({
            type: 'GET', // Use GET method to fetch data
            url: '/Project/SapProjects',
            success: function (response) {
                $.each(response, function (index, project) {
                    // Append each project as an option to the select element
                    $('select[name="state"]:eq(0)').append('<option value="' + project.proj_num + '|' + project.id + '">' + project.proj_name + '</option>');
                });
            },
            error: function (xhr, textStatus, errorThrown) {
                alert('Error: ' + errorThrown);
            }
        });

        // Your existing code for handling search button click and displaying table rows goes here
    });

    $(document).ready(function () {
        // Make an AJAX request to fetch projects
        $.ajax({
            type: 'GET', // Use GET method to fetch data
            url: '/Industry/SapIndustry',
            success: function (response) {
                $.each(response, function (index, industry) {
                    // Append each project as an option to the select element
                    $('select[name="state"]:eq(1)').append('<option value="' + industry.industry_code + '|' + industry.id + '">' + industry.descr + '</option>');
                });
            },
            error: function (xhr, textStatus, errorThrown) {
                alert('Error: ' + errorThrown);
            }
        });

    });


    $(document).ready(function () {
        $('#btnsearch').on('click', function () { // When the search button is clicked
            var project = $('select[name="state"]:eq(0)').val(); // Get the selected project
            var industry = $('select[name="state"]:eq(1)').val(); // Get the selected industry

            var projectId = project.split('|')[1];
            var industryId = industry.split('|')[1];


            // Make an AJAX request to your endpoint
            $.ajax({
                type: 'GET',
                url: '/ReleasedPackages/GetReleasedApplied',
                data: {
                    project_id: projectId,
                    industry_id: industryId,
                },
                success: function (response) {
                    // Assuming response is an array of objects containing data for each row
                    $('#pkgtble').empty(); // Clear the table body

                    $.each(response, function (index, row) {
                        // Check if bid is true, if true, add cancel button, otherwise, add empty cell

                        // Append each row to the table
                        $('#pkgtble').append(
                            '<tr>' +
                            '<td> <a href="#" data-id="' + row.id + '">' + row.pkg_name + ' </a> </td>' +
                            '</tr>'
                        );
                    });
                    // $('#tblbody').show(); // Show the table body
                },
                error: function (xhr, textStatus, errorThrown) {
                    alert('Error: ' + errorThrown);
                }
            });

        });
    });



    $(document).on('click', '#pkgtble a', function () {
        var rowId = $(this).data('id');

        // Make an AJAX request to your endpoint
        $.ajax({
            type: 'GET',
            url: '/Reports/AllAppliedVendors',
            data: {
                package_header_id: rowId
            },
            success: function (response) {
                $('#resulttble').empty();

                var table = document.getElementById('resulttble');

                // Create table header row
                var headerRow = table.insertRow();
                response.columns.forEach(column => {
                    var headerCell = document.createElement('th');
                    headerCell.textContent = column;
                    headerRow.appendChild(headerCell);
                });

                // Create table rows
                response.rows.forEach(rowData => {
                    var row = table.insertRow();
                    Object.values(rowData).forEach(value => {
                        var cell = row.insertCell();
                        cell.textContent = value;
                    });
                });

            },
            error: function (xhr, textStatus, errorThrown) {
                alert('Error: ' + errorThrown);
            }
        });

    });


    document.getElementById('exporttoExcl').addEventListener('click', function () {
        exportToExcel();
    });

    function exportToExcel() {
        // Get reference to the table
        var table = document.getElementById('resulttble');

        // Convert table to workbook
        var wb = XLSX.utils.table_to_book(table, { sheet: "Sheet1" });

        // Save workbook to file
        XLSX.writeFile(wb, 'allapplied_vendors_exported_data.xlsx');
    }

</script>
