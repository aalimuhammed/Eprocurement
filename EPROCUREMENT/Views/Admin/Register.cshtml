@{
    Layout = "_Layout";
}

<div class="container" style="max-width:900px;margin:24px auto;padding:20px;">
    <h2>Register New Admin</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
    }

    <div class="card" style="padding:16px;margin-bottom:18px;">
        <form id="registerForm" method="post" asp-action="Register" asp-controller="Admin">
            @Html.AntiForgeryToken()

            <div style="display:flex;gap:12px;align-items:center;">
                <input type="email"
                       id="username"
                       name="username"
                       placeholder="username@siac-construction.com"
                       required
                       pattern="^[a-zA-Z0-9._%+-]+@@siac-construction\.com$"
                       title="Only emails from siac-construction.com are allowed"
                       class="form-control"
                       style="width:350px;" />

                <div id="usernameError" class="text-danger"></div>

                <input type="password"
                       id="password"
                       name="password"
                       placeholder="Enter password"
                       required
                       class="form-control"
                       style="width:350px;" />

                <div id="passwordError" class="text-danger"></div>

                <button type="submit" class="btn btn-primary">Register</button>
            </div>

            <div style="margin-top:8px;font-size:0.9em;color:#666;">
                Please Enter all the required fields.
            </div>

        </form>
    </div>

</div>

<script>
    document.getElementById("registerForm").addEventListener("submit", function (e) {

        const username = document.getElementById("username").value.trim().toLowerCase();
        const password = document.getElementById("password").value;

        document.getElementById("usernameError").innerText = "";
        document.getElementById("passwordError").innerText = "";

        let isValid = true;

        if (username === "") {
            document.getElementById("usernameError").innerText = "Username is required.";
            isValid = false;
        }
        else {
               const emailRegex = /^[a-zA-Z0-9._%+-]+@@(siac-construction\.com|siacholding\.com)$/i;

                if (!emailRegex.test(username)) {
                    document.getElementById("usernameError").innerText =
                        "Only siac-construction.com and siacholding.com emails are allowed.";
                    isValid = false;
                }
        }

        if (password === "") {
            document.getElementById("passwordError").innerText = "Password is required.";
            isValid = false;
        }

        if (!isValid) {
            e.preventDefault();
        }
    });
</script>