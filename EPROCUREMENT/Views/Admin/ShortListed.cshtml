    function exportToExcel() {
        var originalTable = document.getElementById('shortlisted');
        var tableCopy = originalTable.cloneNode(true);

        // Remove vendor-offer elements
        tableCopy.querySelectorAll('.vendor-offer').forEach(function (element) {
            element.parentNode.removeChild(element);
        });

        // Reveal hidden elements
        tableCopy.querySelectorAll('[hidden]').forEach(function (element) {
            element.removeAttribute('hidden');
        });

        // --- Remove the hidden line_item cell (this was shifting every column) ---
        tableCopy.querySelectorAll('.lineitem').forEach(function (cell) {
            cell.parentNode.removeChild(cell);
        });
        // ---------------------------------------------------------------------

        // Adjust colspans for export
        tableCopy.querySelectorAll('th .vendorHname').forEach(function (headerCell) {
            headerCell.parentElement.setAttribute('colspan', 6);
        });
        tableCopy.querySelectorAll('th#fgrandtotal, th#sgrandtotal, th#thgrandtotal').forEach(function (cell) {
            cell.setAttribute('colspan', 6);
        });

        var wb = XLSX.utils.table_to_book(tableCopy, { sheet: "Sheet1" });
        XLSX.writeFile(wb, 'shortListed_vendors_exported_data.xlsx');
    }

