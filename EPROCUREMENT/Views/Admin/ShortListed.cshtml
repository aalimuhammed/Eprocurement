<style>
    /* ===========================================================
           Vendor Portal — Shortlisted Vendors
           Scoped design system (no business logic touched below)
           =========================================================== */
    .vendor-portal {
        --vp-primary: #2856c9;
        --vp-primary-dark: #1d3f9c;
        --vp-primary-light: #eef2fc;
        --vp-success: #1d9a5c;
        --vp-success-dark: #157a48;
        --vp-danger: #d6483f;
        --vp-danger-dark: #b53b33;
        --vp-secondary: #5b6472;
        --vp-text: #1f2533;
        --vp-text-muted: #6b7280;
        --vp-border: #e1e5ec;
        --vp-bg: #f6f7fb;
        --vp-surface: #ffffff;
        --vp-radius: 10px;
        --vp-radius-sm: 6px;
        --vp-shadow: 0 1px 2px rgba(16, 24, 40, 0.04), 0 4px 10px rgba(16, 24, 40, 0.06);
        color: var(--vp-text);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

        /* ---------- Page header ---------- */
        .vendor-portal .page-header {
            margin-bottom: 20px;
        }

            .vendor-portal .page-header h4 {
                font-size: 22px;
                font-weight: 700;
                letter-spacing: -0.01em;
                color: var(--vp-text);
                margin: 0;
                padding-bottom: 14px;
                border-bottom: 1px solid var(--vp-border);
            }

        /* ---------- Cards ---------- */
        .vendor-portal .card-box {
            background: var(--vp-surface);
            border: 1px solid var(--vp-border);
            border-radius: var(--vp-radius);
            box-shadow: var(--vp-shadow);
        }

        .vendor-portal .text-blue.h4 {
            color: var(--vp-primary-dark);
            font-size: 16px;
            font-weight: 700;
            margin: 0 0 16px;
        }

        /* ---------- Form controls ---------- */
        .vendor-portal .form-group label {
            font-size: 13px;
            font-weight: 600;
            color: var(--vp-text-muted);
            text-transform: uppercase;
            letter-spacing: 0.03em;
            margin-bottom: 6px;
            display: inline-block;
        }

        .vendor-portal .form-control,
        .vendor-portal select.form-control {
            border: 1px solid var(--vp-border);
            border-radius: var(--vp-radius-sm);
            font-size: 14px;
            color: var(--vp-text);
            box-shadow: none;
            transition: border-color .15s ease, box-shadow .15s ease;
        }

            .vendor-portal .form-control:focus,
            .vendor-portal select.form-control:focus {
                border-color: var(--vp-primary);
                box-shadow: 0 0 0 3px rgba(40, 86, 201, 0.12);
                outline: none;
            }

        /* ---------- Buttons (look only — classes/IDs untouched) ---------- */
        .vendor-portal .btn {
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 0.01em;
            padding: 9px 20px;
            border-radius: var(--vp-radius-sm);
            border: 1px solid transparent;
            box-shadow: none;
            text-shadow: none;
            transition: background-color .15s ease, border-color .15s ease, transform .05s ease, box-shadow .15s ease;
        }

            .vendor-portal .btn:active {
                transform: translateY(1px);
            }

        .vendor-portal .btn-primary {
            background-color: var(--vp-primary);
            border-color: var(--vp-primary);
        }

            .vendor-portal .btn-primary:hover,
            .vendor-portal .btn-primary:focus {
                background-color: var(--vp-primary-dark);
                border-color: var(--vp-primary-dark);
                box-shadow: 0 4px 10px rgba(40, 86, 201, 0.25);
            }

        .vendor-portal .btn-success {
            background-color: var(--vp-success);
            border-color: var(--vp-success);
        }

            .vendor-portal .btn-success:hover,
            .vendor-portal .btn-success:focus {
                background-color: var(--vp-success-dark);
                border-color: var(--vp-success-dark);
                box-shadow: 0 4px 10px rgba(29, 154, 92, 0.25);
            }

        .vendor-portal .btn-danger {
            background-color: var(--vp-danger);
            border-color: var(--vp-danger);
        }

            .vendor-portal .btn-danger:hover,
            .vendor-portal .btn-danger:focus {
                background-color: var(--vp-danger-dark);
                border-color: var(--vp-danger-dark);
                box-shadow: 0 4px 10px rgba(214, 72, 63, 0.25);
            }

        .vendor-portal .btn-secondary {
            background-color: var(--vp-surface);
            color: var(--vp-secondary);
            border-color: var(--vp-border);
        }

            .vendor-portal .btn-secondary:hover,
            .vendor-portal .btn-secondary:focus {
                background-color: var(--vp-bg);
                color: var(--vp-text);
            }

        /* ---------- Package list ---------- */
        .vendor-portal #pkgtble tr {
            cursor: pointer;
            transition: background-color .12s ease;
        }

            .vendor-portal #pkgtble tr:hover {
                background-color: var(--vp-primary-light);
            }

        .vendor-portal #pkgtble a {
            color: var(--vp-primary-dark);
            font-weight: 600;
            text-decoration: none;
        }

            .vendor-portal #pkgtble a:hover {
                text-decoration: underline;
            }

        .vendor-portal .highlighted {
            background-color: #fff4cc !important;
        }

        /* ---------- Actions row ---------- */
        .vendor-portal .actions-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
        }

        /* ---------- Comparison table (horizontally scrollable, never broken) ---------- */
        .vendor-portal .table-scroll {
            overflow-x: auto;
            border: 1px solid var(--vp-border);
            border-radius: var(--vp-radius);
            box-shadow: var(--vp-shadow);
            background: var(--vp-surface);
            -webkit-overflow-scrolling: touch;
        }

    #shortlisted {
        border-collapse: collapse;
        width: 100%;
        min-width: 760px;
        font-size: 13.5px;
    }

        #shortlisted th,
        #shortlisted td {
            border: 1px solid var(--vp-border);
            padding: 10px 12px;
            text-align: center;
            white-space: nowrap;
        }

            #shortlisted td.mtrcls {
                text-align: left;
                white-space: normal;
                min-width: 180px;
                font-weight: 500;
            }

        #shortlisted th {
            background-color: #f1f3f8;
            color: var(--vp-text);
            font-weight: 700;
            text-transform: uppercase;
            font-size: 11.5px;
            letter-spacing: 0.04em;
        }

        #shortlisted tr.actualdata:nth-child(even) {
            background-color: #fafbfd;
        }

        #shortlisted tr.actualdata:hover {
            background-color: var(--vp-primary-light);
        }

        #shortlisted #vendornameList th {
            background-color: var(--vp-primary-dark);
            color: #fff;
            font-size: 13px;
            text-transform: none;
            letter-spacing: 0;
            padding: 12px;
        }

        #shortlisted #vendornameList .vendorHname {
            font-weight: 700;
            display: block;
        }

        #shortlisted #vendornameList a.vendor-offer {
            color: #cfe0ff;
            font-size: 11.5px;
            text-decoration: underline;
        }

            #shortlisted #vendornameList a.vendor-offer:hover {
                color: #fff;
            }

        #shortlisted #totalbidding th {
            background-color: #1f2533;
            color: #fff;
            font-size: 12.5px;
            letter-spacing: 0.03em;
        }

    [hidden] {
        display: none !important;
    }

    /* ---------- Accept-offer row ---------- */
    .vendor-portal .accept-offer-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 14px;
        margin-top: 24px;
    }

        .vendor-portal .accept-offer-row .btn {
            min-width: 180px;
            padding: 11px 22px;
        }

    /* ---------- Modal ---------- */
    .vendor-portal .modal-content {
        border-radius: var(--vp-radius);
        border: none;
        box-shadow: 0 12px 40px rgba(16, 24, 40, 0.18);
    }

    .vendor-portal .modal-header {
        background-color: var(--vp-primary-light);
        border-bottom: 1px solid var(--vp-border);
        border-radius: var(--vp-radius) var(--vp-radius) 0 0;
    }

    .vendor-portal .modal-title {
        font-weight: 700;
        color: var(--vp-primary-dark);
        font-size: 16px;
    }

    .vendor-portal .modal-body .table {
        font-size: 13.5px;
        margin-bottom: 24px;
    }

    .vendor-portal .modal-body h4 {
        font-size: 14px;
        font-weight: 700;
        color: var(--vp-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.03em;
        margin-bottom: 10px;
    }

    /* ---------- Responsive breakpoints ---------- */
    @@media (max-width: 768px) {
        .vendor-portal .pd-20

    {
        padding: 16px !important;
    }

    .vendor-portal .actions-row {
        flex-direction: column;
        align-items: stretch;
    }

        .vendor-portal .actions-row .btn {
            width: 100%;
        }

    .vendor-portal .accept-offer-row {
        flex-direction: column;
    }

        .vendor-portal .accept-offer-row .btn {
            width: 100%;
            min-width: 0;
        }

    #shortlisted {
        font-size: 12.5px;
    }

    }
</style>

