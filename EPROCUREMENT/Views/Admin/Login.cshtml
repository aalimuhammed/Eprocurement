@model EPROCUREMENT.Models.LoginModel;
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIAC E-Procurement | Admin Login</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/normalize/5.0.0/normalize.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --navy-deep: #0e2038;
            --navy: #16324f;
            --steel: #2c4f70;
            --slate: #5b7086;
            --paper: #f6f7f9;
            --white: #ffffff;
            --gold: #c8a24d;
            --gold-dim: #a9863c;
            --error: #b3432b;
            --border: #dde3ea;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--paper);
            color: var(--navy-deep);
            display: flex;
            min-height: 100vh;
        }

        /* ---------- Left identity panel ---------- */
        .brand-panel {
            position: relative;
            flex: 1 1 46%;
            max-width: 560px;
            background: radial-gradient(1200px 800px at 15% -10%, rgba(200,162,77,0.12), transparent 55%), linear-gradient(165deg, var(--navy-deep) 0%, var(--navy) 55%, var(--steel) 100%);
            color: var(--white);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 56px 56px 40px;
            overflow: hidden;
        }

            .brand-panel::before {
                /* ledger-grid watermark: a nod to procurement's real material, the schedule of items and unit prices */
                content: "";
                position: absolute;
                inset: 0;
                background-image: repeating-linear-gradient(0deg, rgba(255,255,255,0.035) 0, rgba(255,255,255,0.035) 1px, transparent 1px, transparent 64px), repeating-linear-gradient(90deg, rgba(255,255,255,0.035) 0, rgba(255,255,255,0.035) 1px, transparent 1px, transparent 64px);
                pointer-events: none;
            }

        .brand-mark {
            position: relative;
            display: flex;
            align-items: center;
            gap: 14px;
        }

        /* Placeholder emblem built in SVG. Swap the <svg> below for your real
                   company logo image, e.g. <img src="~/images/company-logo.svg" alt="SIAC" class="brand-logo" /> */
        .brand-logo {
            width: 46px;
            height: 46px;
            flex-shrink: 0;
        }

        .brand-name {
            font-family: 'Source Serif 4', Georgia, serif;
            font-size: 20px;
            font-weight: 700;
            letter-spacing: 0.04em;
            line-height: 1.15;
        }

            .brand-name span {
                display: block;
                font-family: 'Inter', sans-serif;
                font-size: 11px;
                font-weight: 500;
                letter-spacing: 0.16em;
                text-transform: uppercase;
                color: rgba(255,255,255,0.55);
                margin-top: 4px;
            }

        .brand-copy {
            position: relative;
            margin-top: 64px;
        }

            .brand-copy .eyebrow {
                font-size: 12px;
                font-weight: 600;
                letter-spacing: 0.18em;
                text-transform: uppercase;
                color: var(--gold);
                margin-bottom: 18px;
            }

            .brand-copy h1 {
                font-family: 'Source Serif 4', Georgia, serif;
                font-size: 34px;
                line-height: 1.28;
                font-weight: 600;
                margin: 0 0 20px;
                max-width: 380px;
            }

            .brand-copy p {
                font-size: 14.5px;
                line-height: 1.7;
                color: rgba(255,255,255,0.68);
                max-width: 380px;
                margin: 0;
            }

        .brand-foot {
            position: relative;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 12px;
            color: rgba(255,255,255,0.5);
            letter-spacing: 0.02em;
        }

            .brand-foot svg {
                width: 14px;
                height: 14px;
                flex-shrink: 0;
            }

        /* ---------- Right form panel ---------- */
        .form-panel {
            flex: 1 1 54%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 24px;
        }

        .log-form {
            width: 100%;
            max-width: 380px;
        }

            .log-form .form-eyebrow {
                font-size: 12px;
                font-weight: 600;
                letter-spacing: 0.14em;
                text-transform: uppercase;
                color: var(--slate);
                margin: 0 0 8px;
            }

            .log-form h2 {
                font-family: 'Source Serif 4', Georgia, serif;
                font-size: 26px;
                font-weight: 600;
                color: var(--navy-deep);
                margin: 0 0 6px;
            }

            .log-form .subtext {
                font-size: 14px;
                color: var(--slate);
                margin: 0 0 32px;
                line-height: 1.5;
            }

        /* ---------- Validation ---------- */
        .validation-summary-errors {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            background: #fbeeea;
            border: 1px solid #e6bcac;
            border-radius: 6px;
            padding: 12px 14px;
            margin: 0 0 20px;
        }

            .validation-summary-errors.field-validation-valid,
            .validation-summary-errors:empty {
                display: none;
            }

            .validation-summary-errors ul {
                list-style: none;
                margin: 0;
                padding: 0;
            }

            .validation-summary-errors li {
                font-size: 13.5px;
                color: var(--error);
                font-weight: 500;
                line-height: 1.5;
            }

            .validation-summary-errors::before {
                content: "";
                flex-shrink: 0;
                width: 16px;
                height: 16px;
                margin-top: 1px;
                background-color: var(--error);
                -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2'><circle cx='12' cy='12' r='9'/><line x1='12' y1='8' x2='12' y2='13'/><line x1='12' y1='16' x2='12.01' y2='16'/></svg>") center / contain no-repeat;
                mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2'><circle cx='12' cy='12' r='9'/><line x1='12' y1='8' x2='12' y2='13'/><line x1='12' y1='16' x2='12.01' y2='16'/></svg>") center / contain no-repeat;
            }

        .field {
            margin-bottom: 18px;
        }

            .field label {
                display: block;
                font-size: 12.5px;
                font-weight: 600;
                color: var(--navy);
                margin-bottom: 7px;
                letter-spacing: 0.01em;
            }

            .field input {
                width: 100%;
                padding: 12px 14px;
                font-size: 14.5px;
                font-family: 'Inter', sans-serif;
                color: var(--navy-deep);
                background: var(--white);
                border: 1px solid var(--border);
                border-radius: 6px;
                transition: border-color 0.15s ease, box-shadow 0.15s ease;
            }

                .field input::placeholder {
                    color: #a7b2bd;
                }

                .field input:hover {
                    border-color: #c2ccd6;
                }

                .field input:focus {
                    outline: none;
                    border-color: var(--steel);
                    box-shadow: 0 0 0 3px rgba(44,79,112,0.14);
                }

                .field input.input-validation-error {
                    border-color: var(--error);
                    background: #fdf6f4;
                }

                    .field input.input-validation-error:focus {
                        border-color: var(--error);
                        box-shadow: 0 0 0 3px rgba(179,67,43,0.14);
                    }

        .field-validation-error {
            display: block;
            font-size: 12.5px;
            color: var(--error);
            margin-top: 6px;
            font-weight: 500;
        }

        .row-between {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin: -4px 0 26px;
            font-size: 13px;
        }

        .remember {
            display: flex;
            align-items: center;
            gap: 7px;
            color: var(--slate);
        }

            .remember input {
                width: 14px;
                height: 14px;
                accent-color: var(--navy);
            }

        .forgot-link {
            color: var(--steel);
            text-decoration: none;
            font-weight: 500;
        }

            .forgot-link:hover {
                color: var(--navy-deep);
                text-decoration: underline;
            }

        .btn {
            width: 100%;
            padding: 13px 16px;
            font-size: 14.5px;
            font-weight: 600;
            font-family: 'Inter', sans-serif;
            letter-spacing: 0.01em;
            color: var(--white);
            background: linear-gradient(180deg, var(--navy) 0%, var(--navy-deep) 100%);
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.15s ease;
            box-shadow: 0 1px 2px rgba(14,32,56,0.15);
        }

            .btn:hover {
                background: linear-gradient(180deg, var(--steel) 0%, var(--navy) 100%);
                box-shadow: 0 6px 16px rgba(14,32,56,0.22);
            }

            .btn:active {
                transform: translateY(1px);
            }

            .btn:focus-visible {
                outline: 2px solid var(--gold);
                outline-offset: 2px;
            }

        .form-footer {
            margin-top: 28px;
            padding-top: 20px;
            border-top: 1px solid var(--border);
            font-size: 12px;
            color: var(--slate);
            text-align: center;
            line-height: 1.6;
        }

        @@media (max-width: 900px) {
            .brand-panel {
                display: none;
            }

            .form-panel {
                flex: 1 1 100%;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .btn {
                transition: none;
            }
        }
    </style>
</head>
<body>
    <!-- Left: institutional identity panel -->
    <aside class="brand-panel">
        <div class="brand-mark">
            <!-- Placeholder emblem — replace with your real logo, e.g.:
                 <img src="~/images/company-logo.svg" alt="SIAC" class="brand-logo" /> -->
            <svg class="brand-logo" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M24 3 L43 11 V22 C43 33.6 35.4 42.2 24 45 C12.6 42.2 5 33.6 5 22 V11 L24 3 Z"
                      fill="none" stroke="#c8a24d" stroke-width="1.6" />
                <path d="M24 9 L37 14.3 V22 C37 30.8 31.6 37.2 24 39.3 C16.4 37.2 11 30.8 11 22 V14.3 L24 9 Z"
                      fill="rgba(200,162,77,0.08)" stroke="#c8a24d" stroke-width="1" />
                <path d="M17 23.5 L21.6 28 L31.5 18" stroke="#f6f7f9" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div class="brand-name">
                SIAC<span>E-Procurement Portal</span>
            </div>
        </div>

        <div class="brand-copy">
            <div class="eyebrow">Administrator Access</div>
            <h1>Manage RFQS</h1>
            <p>This portal is restricted to authorised SIAC personnel. All sign-in activity is logged and monitored in accordance with organisational security policy.</p>
        </div>

        <div class="brand-foot">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 2l7 3v6c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V5l7-3z" />
            </svg>
            256-bit encrypted connection
        </div>
    </aside>

    <!-- Right: login form -->
    <main class="form-panel">
        <div class="log-form">
            <p class="form-eyebrow">SIAC Panel</p>
            <h2>Sign in to your account</h2>
            <p class="subtext">Enter your administrator credentials to continue.</p>

            <form method="post" asp-action="Login" asp-controller="Admin" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="field">
                    <label for="username">Username</label>
                    <input type="text" id="username" asp-for="username" placeholder="Enter your username" autocomplete="username" required />
                    <span asp-validation-for="username" class="field-validation-error"></span>
                </div>

                <div class="field">
                    <label for="password">Password</label>
                    <input type="password" id="password" asp-for="password" placeholder="Enter your password" autocomplete="current-password" required />
                    <span asp-validation-for="password" class="field-validation-error"></span>
                </div>

                <div class="row-between">
                    <label class="remember">
                        <input type="checkbox" name="rememberMe" />
                        Remember me
                    </label>
                    <a href="#" class="forgot-link">Forgot password?</a>
                </div>

                <button type="submit" class="btn">Sign in</button>

                <div class="form-footer">
                    &copy; @DateTime.Now.Year SIAC. Authorised use only.<br />
                    For access issues, contact your system administrator.
                </div>
            </form>
        </div>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.3/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.11/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
