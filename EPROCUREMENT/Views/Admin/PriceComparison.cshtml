    $(document).ready(function () {
        $('#acceptofferone').on('click', function () {
            var usevalue = $(this).val();

            var confirmBidding = confirm("Are you sure to accept this offer?");

            if (confirmBidding) {
                $.ajax({
                    type: 'POST',
                    url: '/Bidding/AcceptBidding',
                    data: {
                        pkg_id: pkg_header_id,
                        user_id: usevalue
                    },
                    success: function (response) {
                        if (response === 1) {
                            alert("You Accepted this Offer");
                            location.reload();
                        }
                    },
                    error: function (xhr, textStatus, errorThrown) {
                        alert('Error: ' + errorThrown);
                    }
                });
            }
        });
    });



