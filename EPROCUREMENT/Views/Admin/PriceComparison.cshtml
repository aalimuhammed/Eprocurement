                    },
                    error: function (xhr, textStatus, errorThrown) {
                        alert('Error: ' + errorThrown);
                    }
                });
            }
        });
    });

    $(document).ready(function () {
        $('#acceptofferthree').on('click', function () {
            var usevalue = $(this).val();

            var confirmBidding = confirm("Are you sure to accept this offer?");

            if (confirmBidding) {
                $.ajax({
                    type: 'POST',
                    url: '/Bidding/AcceptBidding',
                    data: {
                        pkg_id: pkg_header_id,
                        user_id: usevalue
                    },
                    success: function (response) {
                        if (response === 1) {
                            alert("You Accepted this Offer");
                            location.reload();

                        }
                    },
                    error: function (xhr, textStatus, errorThrown) {
                        alert('Error: ' + errorThrown);
                    }
                });
            }
        });
    });

    document.getElementById('exporttoExcl').addEventListener('click', function () {
        exportToExcel();
    });

    function exportToExcel() {
        // Get reference to the table
        var originalTable = document.getElementById('shortlisted');

        // Create a copy of the table
        var tableCopy = originalTable.cloneNode(true);

        // Remove elements with the class 'vendor-offer'
        var elementsToRemove = tableCopy.querySelectorAll('.vendor-offer');
        elementsToRemove.forEach(function (element) {
            element.parentNode.removeChild(element);
        });

        // Include hidden elements by temporarily removing the hidden attribute
        var hiddenElements = tableCopy.querySelectorAll('[hidden]');
        hiddenElements.forEach(function (element) {
            element.removeAttribute('hidden');
        });

        // Adjust the header cells to span the correct number of columns for export
        var headerCells = tableCopy.querySelectorAll('th .vendorHname');
        headerCells.forEach(function (headerCell) {
            var th = headerCell.parentElement;  // Get the parent <th> element
            th.setAttribute('colspan', 6);
        });

        var grandTotalCells = tableCopy.querySelectorAll('th#fgrandtotal, th#sgrandtotal, th#thgrandtotal');
        grandTotalCells.forEach(function (cell) {
            cell.setAttribute('colspan', 6);
        });
        // Convert the modified table to workbook
        var wb = XLSX.utils.table_to_book(tableCopy, { sheet: "Sheet1" });

        // Save workbook to file
        XLSX.writeFile(wb, 'price_comparison.xlsx');
    }



</script>
