@model IEnumerable<EPROCUREMENT.SapResponse.PackagesResponse>;

<style>
    .highlighted {
        background-color: #ffff99;
    }

    #page-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 9999;
        display: none;
    }

    /* ── Industry multi-select – professional tag UI ── */
    .industry-field-wrap {
        position: relative;
    }

    #industryTagsWrapper {
        border: 1px solid #ced4da;
        border-radius: 6px;
        min-height: 42px;
        max-height: 130px;
        overflow-y: auto;
        padding: 5px 8px;
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        align-items: flex-start;
        background: #fff;
        cursor: default;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

        #industryTagsWrapper:focus-within,
        #industryTagsWrapper.active {
            border-color: #80bdff;
            box-shadow: 0 0 0 3px rgba(0,123,255,.15);
            outline: none;
        }

    .industry-tag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: linear-gradient(135deg, #1a73e8 0%, #0d5dbf 100%);
        color: #fff;
        border-radius: 20px;
        padding: 3px 10px 3px 12px;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: .3px;
        white-space: nowrap;
        box-shadow: 0 1px 3px rgba(13,93,191,.25);
        animation: tagIn .15s ease;
    }

    @@keyframes tagIn {
        from

    {
        opacity: 0;
        transform: scale(.85);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }

    }

    .industry-tag .remove-tag {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: rgba(255,255,255,.25);
        cursor: pointer;
        font-size: 11px;
        font-weight: 700;
        line-height: 1;
        flex-shrink: 0;
        transition: background .15s ease;
    }

        .industry-tag .remove-tag:hover {
            background: rgba(255,255,255,.5);
        }

    #industryPlaceholder {
        color: #adb5bd;
        font-size: 13px;
        padding: 3px 2px;
        pointer-events: none;
        user-select: none;
        align-self: center;
    }

    .industry-count-badge {
        display: none;
        position: absolute;
        top: -8px;
        right: -8px;
        background: #1a73e8;
        color: #fff;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        font-size: 11px;
        font-weight: 700;
        align-items: center;
        justify-content: center;
        box-shadow: 0 1px 4px rgba(0,0,0,.2);
        pointer-events: none;
    }

        .industry-count-badge.visible {
            display: flex;
        }

    #industryHiddenSelect {
        display: none;
    }
</style>

<h2></h2>

<!-- Custom Modal -->
<div class="modal fade" id="customAlert" tabindex="-1" role="dialog" aria-labelledby="customAlertTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="customAlertTitle">Success</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p id="customAlertMessage" class="text-center" style="font-size: 20px;"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="alertModal" tabindex="-1" role="dialog" aria-labelledby="alertModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="alertModalLabel">Manual Assign</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <input type="text" id="searchTextBox" class="form-control" placeholder="Search by Namr Or Tax-ID">
                </div>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Vendor Name</th>
                            <th>Tax ID</th>
                            <th>Select</th>
                        </tr>
                    </thead>
                    <tbody id="searchResultsBody"></tbody>
                </table>

                <h4>Selected Values</h4>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Vendor Name</th>
                            <th>Tax ID</th>
                            <th>Cancel</th>
                        </tr>
                    </thead>
                    <tbody id="selectedValues"></tbody>
                </table>

                <button type="button" id="btnrelease" class="btn btn-success">Release</button>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="page-header">
    <div class="row">
        <div class="col-md-12 col-sm-12">
            <div class="title">
                <h4>Create Packages</h4>
            </div>
        </div>
    </div>
</div>

<div class="pd-20 card-box mb-30">
    <div class="clearfix">
        <div class="pull-left">
            <h4 class="text-blue h4">Selection Criteria</h4>
        </div>
    </div>
    <form id="selectionForm">

        <!-- ── NEW ROW: Type dropdown ── -->
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Select Resource Type <span style="color:red">*</span></label>
                    <select class="form-control" id="typeSelect" style="width: 100%; height: 38px;">
                        <option value="">Please Select Resource Type</option>
                        <option value="Material">Material</option>
                        <option value="Service">Service</option>
                    </select>
                </div>
            </div>
        </div>
        <!-- ── END NEW ROW ── -->

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Select Material Group <span style="color:red">*</span></label>
                    <select class="custom-select2 form-control" id="mtrgrp" style="width: 100%; height: 38px;" disabled>
                        <option value="">Please select Type first</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Select Project <span style="color:red">*</span></label>
                    <select class="custom-select2 form-control" name="state" style="width: 100%; height: 38px;">
                    </select>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label>Select Industry <span style="color:red">*</span></label>
                    <div class="industry-field-wrap">
                        <div id="industryTagsWrapper">
                            <span id="industryPlaceholder">Select a Material Group to add industries…</span>
                        </div>
                        <span class="industry-count-badge" id="industryCountBadge">0</span>
                    </div>
                    <select class="custom-select2 form-control" name="state" id="industryHiddenSelect" multiple style="display:none;">
                    </select>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Date From : <span style="color:red">*</span></label>
                    <input type="text" class="form-control date-picker" id="datefrom" placeholder="Select Date">
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Date To : <span style="color:red">*</span></label>
                    <input type="text" class="form-control date-picker" id="dateto" placeholder="Select Date">
                </div>
            </div>
        </div>
        <br />
        <div class="text-center">
            <button type="button" id="btnsearch" class="btn btn-primary">Search</button>
        </div>
    </form>
</div>

<div class="clearfix mb-20">
    <div class="pull-left">
        <h4 class="text-blue h4">Actions</h4>
    </div>
    <div class="pull-right">
        <label>
            Upload Package File
            <input type="file" id="FileName" />
        </label>
        <button type="button" id="btnaccept" class="btn btn-success">Accept</button>
        <button type="button" id="btnrevoke" class="btn btn-danger">Revoke</button>
        <button type="button" id="btnmanualassign" class="btn btn-primary" data-toggle="modal" data-target="#alertModal">Manual Assign</button>
    </div>
</div>

<div class="pd-20 card-box mb-30">
    <table class="table" id="mtrtble">
        <thead>
            <tr>
                <th scope="col">
                    <input type="checkbox" id="selectAll">
                </th>
                <th scope="col">PR#</th>
                <th scope="col">line Item #</th>
                <th scope="col">PR requisition Date</th>
                <th hidden scope="col">Material Code</th>
                <th hidden scope="col">Material Group</th>
                <th scope="col">Material Desc.</th>
                <th scope="col">Material Long Desc.</th>
                <th scope="col">Material Batch</th>
                <th scope="col">Material requiested QTY</th>
                <th scope="col">Material UOM</th>
            </tr>
        </thead>
        <tbody id="tblbody"></tbody>
    </table>

    <table class="table" id="servtble" hidden>
        <thead>
            <tr>
                <th scope="col">
                    <input type="checkbox" id="selectAll">
                </th>
                <th scope="col">PR#</th>
                <th scope="col">line Item #</th>
                <th scope="col">PR requisition Date</th>
                <th hidden scope="col">Service Code</th>
                <th hidden scope="col">Service Group</th>
                <th scope="col">Service Desc.</th>
                <th scope="col">Service Long Desc.</th>
                <th scope="col">Service requiested QTY</th>
                <th scope="col">Service UOM</th>
            </tr>
        </thead>
        <tbody id="tblbodyserv"></tbody>
    </table>
</div>

<script>
    /* ─────────────────────────────────────────────────────────────
       SECTION 1 – unchanged helpers (row highlighting, select-all)
    ───────────────────────────────────────────────────────────── */
    var currentPage = 1;
    var totalPages  = 1;

    $('#selectAll').change(function () {
        $('.rowCheckbox').prop('checked', $(this).prop('checked'));
        highlightRows();
    });

    $('.rowCheckbox').change(function () {
        highlightRows();
    });

    function highlightRows() {
        $('.rowCheckbox:checked').closest('tr').addClass('highlighted');
        $('.rowCheckbox:not(:checked)').closest('tr').removeClass('highlighted');
    }

    $('#tblbody').on('click', 'tr', function () {
        highlightRows();
    });


    /* ─────────────────────────────────────────────────────────────
       SECTION 2 – NEW: Type → Material Group → Industry (multi)
       All state lives in:
         selectedType        : "Material" | "Service" | ""
         loadedMtrGrpOptions : array of { id, name } (currently loaded)
         industryMap         : { industryCode|industryId → { code, id, label } }
                               tracks which industries are shown as tags
    ───────────────────────────────────────────────────────────── */
    var selectedType        = '';
    var loadedMtrGrpOptions = [];
    var industryMap         = {};   // key = industry_code+'|'+industry_id  →  { code, id, label }
    var searchData          = [];   // accumulates materials/services across all selected industries
    var allIndustries       = [];   // full industry list cached from /Industry/SapIndustry

    /* Utility: rebuild the hidden <select> options and the visual tags */
    function syncIndustryUI() {
        var $hidden      = $('#industryHiddenSelect');
        var $wrapper     = $('#industryTagsWrapper');
        var $badge       = $('#industryCountBadge');

        // Rebuild hidden select
        $hidden.empty();
        $.each(industryMap, function (key, item) {
            $hidden.append(
                $('<option>', {
                    value   : item.code + '|' + item.id,
                    selected: true,
                    text    : item.label
                })
            );
        });

        // Rebuild visual tags
        $wrapper.empty();
        var keys = Object.keys(industryMap);

        // Count badge
        if (keys.length > 0) {
            $badge.text(keys.length).addClass('visible');
        } else {
            $badge.text('0').removeClass('visible');
        }

        if (keys.length === 0) {
            $wrapper.append(
                $('<span id="industryPlaceholder">Select a Material Group to add industries…</span>')
            );
            return;
        }

        $.each(industryMap, function (key, item) {
            var $tag = $('<span class="industry-tag"></span>')
                .append($('<span class="tag-label"></span>').text(item.label))
                .append(
                    $('<span class="remove-tag" title="Remove industry">&#x2715;</span>')
                        .on('click', function () {
                            delete industryMap[key];
                            syncIndustryUI();
                            // Rebuild searchData from remaining industries
                            searchData = [];
                            $.each(industryMap, function (k, remaining) {
                                fetchSearchDataForIndustry(remaining.id);
                            });
                        })
                );
            $wrapper.append($tag);
        });
    }

    /* allIndustries caches the full list from /Industry/SapIndustry so we
       can filter client-side exactly as the original code did —
       matching industry.id === selected mtrgrp id.                         */

    /* Pre-load all industries once when a type is selected (same as original page-load) */
    function preloadAllIndustries() {
        $.ajax({
            type   : 'GET',
            url    : '/Industry/SapIndustry',
            success: function (response) {
                allIndustries = Array.isArray(response) ? response : [];
            },
            error: function (xhr, status, err) {
                alert('Error pre-loading industries: ' + err);
            }
        });
    }

    /* Add the industry whose id matches the selected mtrgrp id —
       exactly the original filter: option value.split('|')[1] === groupId  */
    function addIndustriesForGroup(groupId) {
        if (!groupId) return;

        // Filter from the already-loaded full list — same logic as original
        var matched = $.grep(allIndustries, function (industry) {
            return String(industry.id) === String(groupId);
        });

        if (matched.length === 0) return;

        var newIndustryIds = [];

        $.each(matched, function (i, industry) {
            var key = industry.industry_code + '|' + industry.id;
            if (!industryMap[key]) {
                industryMap[key] = {
                    code : industry.industry_code,
                    id   : industry.id,
                    label: industry.descr
                };
                newIndustryIds.push(industry.id);
            }
        });

        syncIndustryUI();

        // Fetch and accumulate searchData for each newly added industry
        $.each(newIndustryIds, function (i, industryId) {
            fetchSearchDataForIndustry(industryId);
        });
    }

    /* Fetch materials/services for one industry and accumulate into searchData.
       searchData is the array of industry-linked material/service objects
       that gets posted to /PackageDetails/Packages as 'inudstries'.
       Each call merges new items in — deduplication by checking every
       property that could serve as a unique key.                          */
    function fetchSearchDataForIndustry(industryId) {
        $.ajax({
            type   : 'GET',
            url    : '/ServicesMaterial/GetMaterialsServices',
            data   : { industry_id: industryId },
            success: function (response) {
                if (!Array.isArray(response)) return;
                $.each(response, function (i, item) {
                    // Deduplicate: skip if an item with the same industry_id already exists
                    var alreadyIn = false;
                    $.each(searchData, function (j, existing) {
                        // Try every likely unique key your model may expose
                        if (
                            (item.id        !== undefined && existing.id        === item.id)        ||
                            (item.ser_code  !== undefined && existing.ser_code  === item.ser_code)  ||
                            (item.mat_code  !== undefined && existing.mat_code  === item.mat_code)
                        ) {
                            alreadyIn = true;
                            return false; // break
                        }
                    });
                    if (!alreadyIn) searchData.push(item);
                });
            },
            error: function (xhr, textStatus, errorThrown) {
                alert('Error fetching materials/services: ' + errorThrown);
            }
        });
    }

    /* Load Material Group options based on selected type
       paramValue: 1 = Material, 2 = Service  (matches your endpoint) */
    function loadMaterialGroups(type) {
        var $mtrgrp = $('#mtrgrp');
        $mtrgrp.empty().prop('disabled', true);

        if (!type) {
            $mtrgrp.append('<option value="">Please select Type first</option>');
            return;
        }

        var paramValue = (type === 'Material') ? 1 : 2;

        $mtrgrp.append('<option value="">Loading…</option>');

        $.ajax({
            type   : 'GET',
            url    : '/ViewOnly/GetMTROrServiceGrp',
            data   : { paramValue: paramValue },
            success: function (response) {
                $mtrgrp.empty();
                $mtrgrp.append('<option value="">Please Select Material Group</option>');
                loadedMtrGrpOptions = response;
                $.each(response, function (i, grp) {
                    $mtrgrp.append(
                        $('<option>', { value: grp.id, text: grp.name })
                    );
                });
                $mtrgrp.prop('disabled', false);
            },
            error: function (xhr, status, err) {
                $mtrgrp.empty().append('<option value="">Error loading groups</option>');
                alert('Error fetching groups: ' + err);
            }
        });
    }

    $(document).ready(function () {

        /* Type dropdown change */
        $('#typeSelect').on('change', function () {
            selectedType = $(this).val();

            // Clear everything when type changes
            industryMap   = {};
            searchData    = [];
            allIndustries = [];
            syncIndustryUI();

            // Reload material groups AND industry pool for the new type
            loadMaterialGroups(selectedType);
            if (selectedType) preloadAllIndustries();

            $('#industryHiddenSelect').empty();

            // Reload material groups for the chosen type
            loadMaterialGroups(selectedType);

            // Reset the second "state" dropdown (industry hidden select) to clear
            // so downstream existing code (searchData fetch) doesn't carry stale data
            $('#industryHiddenSelect').empty().trigger('change');
        });

        /* Material Group change → accumulate industries */
        $('#mtrgrp').on('change', function () {
            var groupId = $(this).val();

            // Existing behaviour: sync the second "state" dropdown index by
            // also updating the hidden select (done inside addIndustriesForGroup)

            // The original code also tried to set select[name="state"]:eq(1) based
            // on mtrgrp. We replicate the intent: add industries for this group.
            if (groupId) {
                addIndustriesForGroup(groupId);
            }
        });

    });


    /* ─────────────────────────────────────────────────────────────
       SECTION 3 – override the existing select[name="state"]:eq(1)
       .val() call so it returns the FIRST selected industry value,
       preserving backward-compat with all downstream AJAX calls.

       The hidden select is a real <select multiple name="state">, so
       jQuery's $('select[name="state"]:eq(1)') still finds it at
       index 1 (after the project select).  .val() on a multiple
       select returns an array; the existing code does .split('|')[1]
       on the result — so we ensure the hidden select always has at
       least the first option pre-selected, making .val() return the
       first value string as expected by the rest of the code.
    ───────────────────────────────────────────────────────────── */
    // Note: no extra code needed here — the hidden select IS name="state",
    // is at eq(1), and .val() on a <select multiple> returns the first
    // selected value when a single string is expected by .split().


    /* ─────────────────────────────────────────────────────────────
       SECTION 4 – UNCHANGED original code blocks below
       (manual assign, search textbox, projects fetch, industries
        initial load, button enable/disable, accept, release, revoke,
        search, formatDate)
    ───────────────────────────────────────────────────────────── */

    $(document).ready(function () {
        $('#btnmanualassign').on('click', function () {
            $('#searchTextBox').val('');
            $('#searchResultsBody').empty();
        });

        $('#searchTextBox').on('keyup', function (e) {
            if (e.keyCode === 13) {
                var searchTerm = $(this).val();
                fetchSearchResults(searchTerm);
            }
        });

        function fetchSearchResults(searchTerm) {
            $.ajax({
                type   : 'GET',
                url    : '/Admin/Search',
                data   : { searchTerm: searchTerm },
                success: function (response) {
                    $('#searchResultsBody').empty();
                    if (Array.isArray(response)) {
                        $.each(response, function (index, user) {
                            $('#searchResultsBody').append('<tr><td>' + user.company + '</td><td>' + user.tax_id + '</td><td><button class="btn btn-success" value="' + user.id + '">Select</button></td></tr>');
                        });
                    } else if (response === "No Data Found") {
                        $('#searchResultsBody').html('<tr><td colspan="3">No Data Found</td></tr>');
                    } else {
                        $('#searchResultsBody').append('<tr><td>' + response.company + '</td><td>' + response.tax_id + '</td><td><button class="btn btn-success" value="' + response.id + '">Select</button></td></tr>');
                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                    alert('Error: ' + errorThrown);
                }
            });
        }

        $(document).on('click', '#searchResultsBody button', function () {
            var selectedRow = $(this).closest('tr');
            selectedRow.hide();
            var vendorName = $(this).closest('tr').find('td:first').text();
            var taxId      = $(this).closest('tr').find('td:eq(1)').text();
            var userId     = selectedRow.find('.btn-success').val();
            $('#selectedValues').append('<tr><td>' + vendorName + '</td><td>' + taxId + '</td><td hidden><input type="hidden" class="selected" value="' + userId + '"></td><td><button class="btn btn-danger cancelBtn">Cancel</button></td></tr>');
        });

        $(document).on('click', '.cancelBtn', function () {
            var canceledRow = $(this).closest('tr');
            canceledRow.remove();
            var vendorName = canceledRow.find('td:first').text();
            var taxId      = canceledRow.find('td:eq(1)').text();
            $('#searchResultsBody tr').each(function () {
                var row = $(this);
                if (row.find('td:first').text() === vendorName && row.find('td:eq(1)').text() === taxId) {
                    row.show();
                    return false;
                }
            });
        });
    });


    $(document).ready(function () {
        $("input").prop('required', true);

        $('select[name="state"]:eq(0)').append('<option value="">Please Select your Project</option>');
        $.ajax({
            type   : 'GET',
            url    : '/Project/SapProjects',
            success: function (response) {
                $.each(response, function (index, project) {
                    $('select[name="state"]:eq(0)').append('<option value="' + project.proj_num + '|' + project.id + '">' + project.proj_name + '</option>');
                });
            },
            error: function (xhr, textStatus, errorThrown) {
                alert('Error: ' + errorThrown);
            }
        });
    });


    /*
     * NOTE: The original block that fetched /ViewOnly/GetMaterialsGrp on page-load
     * is intentionally REMOVED here because material group options now depend on the
     * Type selection.  The loadMaterialGroups() function above handles that fetch.
     * The original mtrgrp.change() handler that synced select[name="state"]:eq(1)
     * is also replaced by addIndustriesForGroup() above.
     * Everything else is identical.
     */


    /*
     * The original block that pre-populated select[name="state"]:eq(1) with all
     * industries on page-load is also removed — industries are now added lazily
     * per material group selection.  The hidden select (#industryHiddenSelect)
     * carries the live multi-value state.
     */


    $(document).ready(function () {
        $('#btnaccept, #btnrevoke, #btnmanualassign').prop('disabled', true);

        function toggleButtons() {
            var fileNotEmpty       = $('#FileName')[0].files.length > 0;
            var checkboxesChecked  = $('.rowCheckbox:checked').length > 0;
            $('#btnaccept, #btnmanualassign').prop('disabled', !(fileNotEmpty && checkboxesChecked));
            $('#btnrevoke').prop('disabled', !checkboxesChecked);
        }

        $('#FileName').on('change', function () {
            toggleButtons();
        });

        $('#tblbody').on('change', '.rowCheckbox', function () {
            toggleButtons();
        });
    });


    $(document).ready(function () {
        $('#btnaccept').on('click', function () {
            var project      = $('select[name="state"]:eq(0)').val();
            var industry     = $('select[name="state"]:eq(1)').val();

            var project_name  = $('select[name="state"]:eq(0) option:selected').text();
            // For multi-select, show first selected industry label in pack_name
            var industry_name = $('select[name="state"]:eq(1) option:selected').first().text();

            var projectId  = project.split('|')[1];
            // industry may be an array (multiple select); take first for industryId
