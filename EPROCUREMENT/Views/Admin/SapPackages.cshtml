    $(document).ready(function () {
        $('#btnrevoke').on('click', function () {
            var project    = $('select[name="state"]:eq(0)').val();
            var industry   = $('select[name="state"]:eq(1)').val();
            var projectId  = project.split('|')[1];
            var industryVal = Array.isArray(industry) ? industry[0] : industry;
            var industryId  = industryVal ? industryVal.split('|')[1] : '';

            var selectedRowsData = [];
            $('.rowCheckbox:checked').each(function () {
                var row = $(this).closest('tr');
                selectedRowsData.push({
                    pr          : row.find('td:eq(1)').text(),
                    pr_item     : row.find('td:eq(2)').text(),
                    pr_req_date : row.find('td:eq(3)').text(),
                    mat_code    : row.find('td:eq(4)').text(),
                    m_grp       : row.find('td:eq(5)').text(),
                    mat_desc    : row.find('td:eq(6)').text(),
                    m_long_desc : row.find('td:eq(7)').text(),
                    m_batch     : row.find('td:eq(8)').text(),
                    m_req_qty   : row.find('td:eq(9)').text(),
                    m_uom       : row.find('td:eq(10)').text()
                });
            });

            $.ajax({
                type : 'POST',
                url  : '/RevokedPackages/Revoke',
                data : { project_id: projectId, industry_id: industryId, selected_rows: selectedRowsData },
                success: function (response) {
                    if (response === 1) {
                        $('#customAlertMessage').text("Selected Items has been Revoked");
                        $('#customAlert').modal('show');
                        $('#tblbody').empty();
                        $('#alertModal').modal('hide');
                        $('#searchResultsBody').empty();
                        $('#selectedValues').empty();
                        softResetUI();
                    }
                },
                error: function (xhr, textStatus, errorThrown) { alert('Error: ' + errorThrown); }
            });
        });
    });


    $(document).ready(function () {

        /*
         * searchData is accumulated at module level via fetchSearchDataForIndustry()
         * called automatically from addIndustriesForGroup() each time a new industry tag
         * is added. It holds the merged materials/services across ALL selected industries
         * and is posted as 'inudstries' to /PackageDetails/Packages on Search.
         */

        /* ── Full validation: checks every required field individually ── */
        function validateAll() {
            var errors = [];

            if (!$('#typeSelect').val()) {
                errors.push('• Resource Type is required.');
            }
            if (!$('#mtrgrp').val()) {
                errors.push('• Material Group is required.');
            }
            if (!$('select[name="state"]:eq(0)').val()) {
                errors.push('• Project is required.');
            }
            if (Object.keys(industryMap).length === 0) {
                errors.push('• At least one Industry is required (select a Material Group first).');
            }
            if ($.trim($('#datefrom').val()) === '') {
                errors.push('• Date From is required.');
            }
            if ($.trim($('#dateto').val()) === '') {
                errors.push('• Date To is required.');
            }

            if ($.trim($('#currencySelect').val()) === '') {
                errors.push('• Currency is required.');
            }

            if (errors.length > 0) {
                alert('Please fix the following before searching:\n\n' + errors.join('\n'));
                return false;
            }

            // Guard: searchData is populated asynchronously — warn if still empty
            if (searchData.length === 0) {
                alert('Industry data is still loading. Please wait a moment and try again.');
                return false;
            }

            return true;
        }

        $('#btnsearch').on('click', function () {
            if (!validateAll()) return;

            var project   = $('select[name="state"]:eq(0)').val();
            var fromDate  = $('#datefrom').val();
            var toDate    = $('#dateto').val();
            var projectId = project.split('|')[0];

            $.ajax({
                type : 'POST',
                url  : '/PackageDetails/Packages',
                data : {
                    project_num : projectId,
                    datefrom    : formatDate(fromDate),
                    dateTo      : formatDate(toDate),
                    inudstries  : searchData   // full multi-industry accumulated array
                },
                beforeSend: function () {
                    showBusyOverlay('Searching…');
                },
                success: function (response) {
                    $('#tblbody').empty();
                    $('#tblbodyserv').empty();
                    clearTableFilters();

                    if (!response || response.length === 0) {
                        alert('No data found.');
                        return;
                    }

                    if (response[0].hasOwnProperty('seR_CODE')) {
                        $.each(response, function (index, row) {
                            var reqDate       = new Date(row.pR_REQ_DATE);
                            var formattedDate = reqDate.getDate() + '-' + (reqDate.getMonth() + 1) + '-' + reqDate.getFullYear();
                            $('#tblbodyserv').append(
                                '<tr>' +
                                '<td><input type="checkbox" class="rowCheckbox"></td>' +
                                '<td>' + row.pr        + '</td>' +
                                '<td>' + row.pR_ITEM   + '</td>' +
                                '<td>' + formattedDate  + '</td>' +
                                '<td hidden>' + row.seR_CODE + '</td>' +
                                '<td hidden>' + row.s_GRP    + '</td>' +
                                '<td>' + row.seR_DESC   + '</td>' +
                                '<td>' + row.s_LON_DES  + '</td>' +
                                '<td>' + row.s_REQ_QTY  + '</td>' +
                                '<td>' + row.s_UNIT     + '</td>' +
                                '</tr>'
                            );
                        });
                        $('#servtble').removeAttr('hidden');
                        $('#mtrtble').attr('hidden', true);
                    } else {
                        $.each(response, function (index, row) {
                            var reqDate       = new Date(row.pR_REQ_DATE);
                            var formattedDate = reqDate.getDate() + '-' + (reqDate.getMonth() + 1) + '-' + reqDate.getFullYear();
                            $('#tblbody').append(
                                '<tr>' +
                                '<td><input type="checkbox" class="rowCheckbox"></td>' +
                                '<td>' + row.pr        + '</td>' +
                                '<td>' + row.pR_ITEM   + '</td>' +
                                '<td>' + formattedDate  + '</td>' +
                                '<td hidden>' + row.maT_CODE + '</td>' +
                                '<td hidden>' + row.m_GRP    + '</td>' +
                                '<td>' + row.maT_DESC   + '</td>' +
                                '<td>' + row.m_LON_DES  + '</td>' +
                                '<td>' + row.m_BATCH    + '</td>' +
                                '<td>' + row.m_REQ_QTY  + '</td>' +
                                '<td>' + row.m_UNIT     + '</td>' +
                                '</tr>'
                            );
                        });
                        $('#servtble').attr('hidden', true);
                        $('#mtrtble').attr('hidden', false);
                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                    alert('Error: ' + errorThrown);
                },
                complete: function () {
                    hideBusyOverlay();
                }
            });
        });
    });


    function formatDate(dateString) {
        var date  = new Date(dateString);
        var year  = date.getFullYear();
        var month = (date.getMonth() + 1).toString().padStart(2, '0');
        var day   = date.getDate().toString().padStart(2, '0');
        return year + month + day;
    }
</script>
