    /* allIndustries caches the full list from /Industry/SapIndustry so we
       can filter client-side exactly as the original code did —
       matching industry.id === selected mtrgrp id.                         */

    var selectedType        = '';
    var loadedMtrGrpOptions = [];
    var industryMap         = {};   // key = industry_code+'|'+industry_id  →  { code, id, label }
    var searchData          = [];   // accumulates materials/services across all selected industries
    var allIndustries       = [];   // full industry list cached from /Industry/SapIndustry

    /* Utility: rebuild the hidden <select> options and the visual tags */
    function syncIndustryUI() {
        var $hidden      = $('#industryHiddenSelect');
        var $wrapper     = $('#industryTagsWrapper');
        var $badge       = $('#industryCountBadge');

        // Rebuild hidden select
        $hidden.empty();
        $.each(industryMap, function (key, item) {
            $hidden.append(
                $('<option>', {
                    value   : item.code + '|' + item.id,
                    selected: true,
                    text    : item.label
                })
            );
        });

        // Rebuild visual tags
        $wrapper.empty();
        var keys = Object.keys(industryMap);

        // Count badge
        if (keys.length > 0) {
            $badge.text(keys.length).addClass('visible');
        } else {
            $badge.text('0').removeClass('visible');
        }

        if (keys.length === 0) {
            $wrapper.append(
                $('<span id="industryPlaceholder">Select a Material Group to add industries…</span>')
            );
            return;
        }

        $.each(industryMap, function (key, item) {
            var $tag = $('<span class="industry-tag"></span>')
                .append($('<span class="tag-label"></span>').text(item.label))
                .append(
                    $('<span class="remove-tag" title="Remove industry">&#x2715;</span>')
                        .on('click', function () {
                            delete industryMap[key];
                            syncIndustryUI();
                            // Rebuild searchData from remaining industries
                            searchData = [];
                            $.each(industryMap, function (k, remaining) {
                                fetchSearchDataForIndustry(remaining.id);
                            });
                        })
                );
            $wrapper.append($tag);
        });
    }

    /* Pre-load all industries once when a type is selected (same as original page-load) */
    function preloadAllIndustries() {
        $.ajax({
            type   : 'GET',
            url    : '/Industry/SapIndustry',
            success: function (response) {
                allIndustries = Array.isArray(response) ? response : [];
            },
            error: function (xhr, status, err) {
                alert('Error pre-loading industries: ' + err);
            }
        });
    }

    /* Add the industry whose id matches the selected mtrgrp id —
       exactly the original filter: option value.split('|')[1] === groupId  */
    function addIndustriesForGroup(groupId) {
        if (!groupId) return;

        // Filter from the already-loaded full list — same logic as original
        var matched = $.grep(allIndustries, function (industry) {
            return String(industry.id) === String(groupId);
        });

        if (matched.length === 0) return;

        var newIndustryIds = [];

        $.each(matched, function (i, industry) {
            var key = industry.industry_code + '|' + industry.id;
            if (!industryMap[key]) {
                industryMap[key] = {
                    code : industry.industry_code,
                    id   : industry.id,
                    label: industry.descr
                };
                newIndustryIds.push(industry.id);
            }
        });

        syncIndustryUI();

        // Fetch and accumulate searchData for each newly added industry
        $.each(newIndustryIds, function (i, industryId) {
            fetchSearchDataForIndustry(industryId);
        });
    }

    /* Fetch materials/services for one industry and accumulate into searchData.
       searchData is the array of industry-linked material/service objects
       that gets posted to /PackageDetails/Packages as 'inudstries'.
       Each call merges new items in — deduplication by checking every
       property that could serve as a unique key.                          */
    function fetchSearchDataForIndustry(industryId) {
        $.ajax({
            type   : 'GET',
            url    : '/ServicesMaterial/GetMaterialsServices',
            data   : { industry_id: industryId },
            success: function (response) {
                if (!Array.isArray(response)) return;
                $.each(response, function (i, item) {
                    // Deduplicate: skip if an item with the same industry_id already exists
                    var alreadyIn = false;
                    $.each(searchData, function (j, existing) {
                        // Try every likely unique key your model may expose
                        if (
                            (item.id        !== undefined && existing.id        === item.id)        ||
                            (item.ser_code  !== undefined && existing.ser_code  === item.ser_code)  ||
                            (item.mat_code  !== undefined && existing.mat_code  === item.mat_code)
                        ) {
                            alreadyIn = true;
                            return false; // break
                        }
                    });
                    if (!alreadyIn) searchData.push(item);
                });
            },
            error: function (xhr, textStatus, errorThrown) {
                alert('Error fetching materials/services: ' + errorThrown);
            }
        });
    }

    /* Load Material Group options based on selected type
       paramValue: 1 = Material, 2 = Service  (matches your endpoint) */
    function loadMaterialGroups(type) {
        var $mtrgrp = $('#mtrgrp');
        $mtrgrp.empty().prop('disabled', true);

        if (!type) {
            $mtrgrp.append('<option value="">Please select Type first</option>');
            return;
        }

        var paramValue = (type === 'Material') ? 1 : 2;

        $mtrgrp.append('<option value="">Loading…</option>');

        $.ajax({
            type   : 'GET',
            url    : '/ViewOnly/GetMTROrServiceGrp',
            data   : { paramValue: paramValue },
            success: function (response) {
                $mtrgrp.empty();
                $mtrgrp.append('<option value="">Please Select Material Group</option>');
                loadedMtrGrpOptions = response;
                $.each(response, function (i, grp) {
                    $mtrgrp.append(
                        $('<option>', { value: grp.id, text: grp.name })
                    );
                });
                $mtrgrp.prop('disabled', false);
            },
            error: function (xhr, status, err) {
                $mtrgrp.empty().append('<option value="">Error loading groups</option>');
                alert('Error fetching groups: ' + err);
            }
        });
    }

