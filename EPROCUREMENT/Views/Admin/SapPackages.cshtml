@model IEnumerable<EPROCUREMENT.SapResponse.PackagesResponse>;

<style>
    .highlighted {
        background-color: #ffff99;
    }

    /* ── Busy / loading overlay (now fully styled & reusable) ── */
    #page-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.55);
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
    }

        #page-overlay .busy-box {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 14px;
            background: #ffffff;
            padding: 28px 36px;
            border-radius: 10px;
            box-shadow: 0 6px 24px rgba(0,0,0,.35);
            min-width: 220px;
            max-width: 90vw;
        }

        #page-overlay .spinner-border {
            width: 3rem;
            height: 3rem;
            color: #1a73e8;
        }

        #page-overlay .busy-text {
            font-size: 15px;
            font-weight: 600;
            color: #333;
            text-align: center;
        }

    /* Inline button spinner (used on the buttons themselves) */
    .btn-spinner {
        display: inline-block;
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255,255,255,.55);
        border-top-color: #fff;
        border-radius: 50%;
        margin-right: 6px;
        vertical-align: -2px;
        animation: btnSpin .6s linear infinite;
    }

    @@keyframes btnSpin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    /* ── Industry multi-select – professional tag UI ── */
    .industry-field-wrap {
        position: relative;
    }

    #industryTagsWrapper {
        border: 1px solid #ced4da;
        border-radius: 6px;
        min-height: 42px;
        max-height: 130px;
        overflow-y: auto;
        padding: 5px 8px;
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        align-items: flex-start;
        background: #fff;
        cursor: default;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

        #industryTagsWrapper:focus-within,
        #industryTagsWrapper.active {
            border-color: #80bdff;
            box-shadow: 0 0 0 3px rgba(0,123,255,.15);
            outline: none;
        }

    .industry-tag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: linear-gradient(135deg, #1a73e8 0%, #0d5dbf 100%);
        color: #fff;
        border-radius: 20px;
        padding: 3px 10px 3px 12px;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: .3px;
        white-space: nowrap;
        box-shadow: 0 1px 3px rgba(13,93,191,.25);
        animation: tagIn .15s ease;
    }

    @@keyframes tagIn {
        from {
            opacity: 0;
            transform: scale(.85);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .industry-tag .remove-tag {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: rgba(255,255,255,.25);
        cursor: pointer;
        font-size: 11px;
        font-weight: 700;
        line-height: 1;
        flex-shrink: 0;
        transition: background .15s ease;
    }

        .industry-tag .remove-tag:hover {
            background: rgba(255,255,255,.5);
        }

    #industryPlaceholder {
        color: #adb5bd;
        font-size: 13px;
        padding: 3px 2px;
        pointer-events: none;
        user-select: none;
        align-self: center;
    }

    .industry-count-badge {
        display: none;
        position: absolute;
        top: -8px;
        right: -8px;
        background: #1a73e8;
        color: #fff;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        font-size: 11px;
        font-weight: 700;
        align-items: center;
        justify-content: center;
        box-shadow: 0 1px 4px rgba(0,0,0,.2);
        pointer-events: none;
    }

        .industry-count-badge.visible {
            display: flex;
        }

    #industryHiddenSelect {
        display: none;
    }

    /* ── NEW: Table filter toolbar ── */
    .table-filter-row th {
        background: #f7f9fb;
        padding: 6px 6px;
        border-top: none;
    }

    .col-filter {
        width: 100%;
        font-size: 12px;
        padding: 4px 6px;
        height: 30px;
        border: 1px solid #dfe3e8;
        border-radius: 4px;
    }

    .table-responsive-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .no-results-row td {
        text-align: center;
        color: #9aa3ad;
        font-style: italic;
        padding: 18px;
    }

    /* ── NEW: Duration input group (number + type dropdown) ──
           Used for Credit Period and Delivery Duration fields.
           Presents a single joined control: number entry + a type
           select (Days / Months / Years), matching the existing
           form-control styling used elsewhere on this page.       */
    .duration-input-group {
        display: flex;
        align-items: stretch;
        border-radius: 6px;
        overflow: hidden;
    }

        .duration-input-group .duration-number {
            flex: 1 1 58%;
            border-top-right-radius: 0 !important;
            border-bottom-right-radius: 0 !important;
            border-right: none;
            text-align: left;
        }

        .duration-input-group .duration-type-select {
            flex: 1 1 42%;
            max-width: 130px;
            border-top-left-radius: 0 !important;
            border-bottom-left-radius: 0 !important;
            border-left: 1px solid #ced4da;
            background-color: #f7f9fb;
            font-weight: 500;
            color: #495057;
        }

            .duration-input-group .duration-number:focus,
            .duration-input-group .duration-type-select:focus {
                position: relative;
                z-index: 1;
                border-color: #80bdff;
                box-shadow: 0 0 0 3px rgba(0,123,255,.15);
                outline: none;
            }

    /* ── NEW: Responsive tweaks ── */
    @@media (max-width: 991px) {
        .pd-20 {
            padding: 14px !important;
        }
    }

    @@media (max-width: 767px) {
        .clearfix.mb-20 .pull-left,
        .clearfix.mb-20 .pull-right {
            float: none !important;
            display: block;
            width: 100%;
        }

            .clearfix.mb-20 .pull-right label,
            .clearfix.mb-20 .pull-right .btn {
                display: block;
                width: 100%;
                margin: 0 0 8px 0;
                text-align: left;
            }

            .clearfix.mb-20 .pull-right input[type="file"] {
                display: block;
                width: 100%;
                margin-top: 6px;
            }

        .text-center .btn {
            width: 100%;
        }

        #industryTagsWrapper {
            max-height: 110px;
        }

        .modal-dialog {
            margin: 8px;
        }

        .col-filter {
            font-size: 11px;
        }

        .duration-input-group .duration-type-select {
            max-width: 110px;
        }
    }

    @@media (max-width: 575px) {
        .table-filter-row {
            display: none; /* keep small screens uncluttered; horizontal scroll still works */
        }

            .table-filter-row.force-show {
                display: table-row;
            }
    }
</style>

<h2></h2>

<!-- Custom Modal -->
<div class="modal fade" id="customAlert" tabindex="-1" role="dialog" aria-labelledby="customAlertTitle" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="customAlertTitle">Success</h5>
                <button type="button" class="close" id="customAlertCloseIcon" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p id="customAlertMessage" class="text-center" style="font-size: 20px;"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="customAlertCloseBtn">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="alertModal" tabindex="-1" role="dialog" aria-labelledby="alertModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="alertModalLabel">Manual Assign</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <input type="text" id="searchTextBox" class="form-control" placeholder="Search by Namr Or Tax-ID">
                </div>
                <div class="table-responsive-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Vendor Name</th>
                                <th>Tax ID</th>
                                <th>Select</th>
                            </tr>
                        </thead>
                        <tbody id="searchResultsBody"></tbody>
                    </table>
                </div>

                <h4>Selected Values</h4>
                <div class="table-responsive-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Vendor Name</th>
                                <th>Tax ID</th>
                                <th>Cancel</th>
                            </tr>
                        </thead>
                        <tbody id="selectedValues"></tbody>
                    </table>
                </div>

                <button type="button" id="btnrelease" class="btn btn-success">Release</button>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ── NEW: Busy / processing overlay ── -->
<div id="page-overlay">
    <div class="busy-box">
        <div class="spinner-border" role="status" aria-hidden="true"></div>
        <div id="page-overlay-text" class="busy-text">Processing…</div>
    </div>
</div>

<div class="page-header">
    <div class="row">
        <div class="col-md-12 col-sm-12">
            <div class="title">
                <h4>Create Packages</h4>
            </div>
        </div>
    </div>
</div>

<div class="pd-20 card-box mb-30">
    <div class="clearfix">
        <div class="pull-left">
            <h4 class="text-blue h4">Selection Criteria</h4>
        </div>
    </div>
    <form id="selectionForm">

        <!-- ── NEW ROW: Type dropdown ── -->
        <div class="row">
            <div class="col-md-6 col-sm-12">
                <div class="form-group">
                    <label>Select Resource Type <span style="color:red">*</span></label>
                    <select class="form-control" id="typeSelect" style="width: 100%; height: 38px;">
                        <option value="">Please Select Resource Type</option>
                        <option value="Material">Material</option>
                        <option value="Service">Service</option>
                    </select>
                </div>
            </div>
        </div>
        <!-- ── END NEW ROW ── -->

        <div class="row">
            <div class="col-md-6 col-sm-12">
                <div class="form-group">
                    <label>Select Material Group <span style="color:red">*</span></label>
                    <select class="custom-select2 form-control" id="mtrgrp" style="width: 100%; height: 38px;" disabled>
                        <option value="">Please select Type first</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 col-sm-12">
                <div class="form-group">
                    <label>Select Project <span style="color:red">*</span></label>
                    <select class="custom-select2 form-control" name="state" style="width: 100%; height: 38px;">
                    </select>
                </div>
            </div>

            <div class="col-md-6 col-sm-12">
                <div class="form-group">
                    <label>Select Industry <span style="color:red">*</span></label>
                    <div class="industry-field-wrap">
                        <div id="industryTagsWrapper">
                            <span id="industryPlaceholder">Select a Material Group to add industries…</span>
                        </div>
                        <span class="industry-count-badge" id="industryCountBadge">0</span>
                    </div>
                    <select class="custom-select2 form-control" name="state" id="industryHiddenSelect" multiple style="display:none;">
                    </select>
                </div>
            </div>

            <div class="col-md-6 col-sm-12">
                <div class="form-group">
                    <label>Select Currency <span style="color:red">*</span></label>
                    <select class="form-control" id="currencySelect" style="width: 100%; height: 38px;">
                        <option value="">Please Select Currency</option>
                        <option value="EGP">EGP</option>
                        <option value="USD">USD</option>
                        <option value="EUR">EUR</option>
                        <option value="SAR">SAR</option>
                        <option value="AED">AED</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 col-sm-12">
                <div class="form-group">
                    <label>PR Date From : <span style="color:red">*</span></label>
                    <input type="text" class="form-control date-picker" id="datefrom" placeholder="Select Date">
                </div>
            </div>
            <div class="col-md-6 col-sm-12">
                <div class="form-group">
                    <label>PR Date To : <span style="color:red">*</span></label>
                    <input type="text" class="form-control date-picker" id="dateto" placeholder="Select Date">
                </div>
            </div>
        </div>

        <!-- ── NEW ROW: Credit Period / Delivery Duration / Expiration Date ── -->
        <div class="row">
            <div class="col-md-4 col-sm-12">
                <div class="form-group">
                    <label>Credit Period <span style="color:red">*</span></label>
                    <div class="duration-input-group">
                        <input type="text"
                               inputmode="numeric"
                               autocomplete="off"
                               class="form-control duration-number"
                               id="creditPeriod"
                               placeholder="e.g. 30"
                               maxlength="5">
                        <select class="form-control duration-type-select" id="creditPeriodType">
                            <option value="">Type</option>
                            <option value="Days">Days</option>
                            <option value="Months">Months</option>
                            <option value="Years">Years</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="col-md-4 col-sm-12">
                <div class="form-group">
                    <label>Delivery Duration <span style="color:red">*</span></label>
                    <div class="duration-input-group">
                        <input type="text"
                               inputmode="numeric"
                               autocomplete="off"
                               class="form-control duration-number"
                               id="deliveryDuration"
                               placeholder="e.g. 15"
                               maxlength="5">
                        <select class="form-control duration-type-select" id="deliveryDurationType">
                            <option value="">Type</option>
                            <option value="Days">Days</option>
                            <option value="Months">Months</option>
                            <option value="Years">Years</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="col-md-4 col-sm-12">
                <div class="form-group">
                    <label>Expiration Date <span style="color:red">*</span></label>
                    <input type="date" class="form-control" id="expirationDate" style="height: 38px;">
                </div>
            </div>
        </div>
        <!-- ── END NEW ROW ── -->

        <br />
        <div class="text-center">
            <button type="button" id="btnsearch" class="btn btn-primary">Search</button>
        </div>
    </form>
</div>

<div class="clearfix mb-20">
    <div class="pull-left">
        <h4 class="text-blue h4">Actions</h4>
    </div>
    <div class="pull-right">
        <label>
            Upload Package File
            <input type="file" id="FileName" />
        </label>
        <button type="button" id="btnaccept" class="btn btn-success">Accept</button>
        <button type="button" id="btnrevoke" class="btn btn-danger">Revoke</button>
        <button type="button" id="btnmanualassign" class="btn btn-primary" data-toggle="modal" data-target="#alertModal">Manual Assign</button>
    </div>
</div>

<div class="pd-20 card-box mb-30">

    <div class="table-responsive-wrap">
        <table class="table" id="mtrtble">
            <thead>
                <tr>
                    <th scope="col">
                        <input type="checkbox" id="selectAllMaterial">
                    </th>
                    <th scope="col">PR#</th>
                    <th scope="col">line Item #</th>
                    <th scope="col">PR requisition Date</th>
                    <th hidden scope="col">Material Code</th>
                    <th hidden scope="col">Material Group</th>
                    <th scope="col">Material Desc.</th>
                    <th scope="col">Material Long Desc.</th>
                    <th scope="col">Material Batch</th>
                    <th scope="col">Material requiested QTY</th>
                    <th scope="col">Material UOM</th>
                </tr>
                <!-- ── NEW: filter row (client-side, visual filtering only) ── -->
                <tr class="table-filter-row">
                    <th></th>
                    <th><input type="text" class="col-filter" data-col="1" placeholder="Filter PR#"></th>
                    <th><input type="text" class="col-filter" data-col="2" placeholder="Filter Item#"></th>
                    <th><input type="text" class="col-filter" data-col="3" placeholder="Filter Date"></th>
                    <th hidden></th>
                    <th hidden></th>
                    <th><input type="text" class="col-filter" data-col="6" placeholder="Filter Desc."></th>
                    <th><input type="text" class="col-filter" data-col="7" placeholder="Filter Long Desc."></th>
                    <th><input type="text" class="col-filter" data-col="8" placeholder="Filter Batch"></th>
                    <th><input type="text" class="col-filter" data-col="9" placeholder="Filter Qty"></th>
                    <th><input type="text" class="col-filter" data-col="10" placeholder="Filter UOM"></th>
                </tr>
            </thead>
            <tbody id="tblbody"></tbody>
        </table>
    </div>

    <div class="table-responsive-wrap">
        <table class="table" id="servtble" hidden>
            <thead>
                <tr>
                    <th scope="col">
                        <input type="checkbox" id="selectAllService">
                    </th>
                    <th scope="col">PR#</th>
                    <th scope="col">line Item #</th>
                    <th scope="col">PR requisition Date</th>
                    <th hidden scope="col">Service Code</th>
                    <th hidden scope="col">Service Group</th>
                    <th scope="col">Service Desc.</th>
                    <th scope="col">Service Long Desc.</th>
                    <th scope="col">Service requiested QTY</th>
                    <th scope="col">Service UOM</th>
                </tr>
                <!-- ── NEW: filter row (client-side, visual filtering only) ── -->
                <tr class="table-filter-row">
                    <th></th>
                    <th><input type="text" class="col-filter" data-col="1" placeholder="Filter PR#"></th>
                    <th><input type="text" class="col-filter" data-col="2" placeholder="Filter Item#"></th>
                    <th><input type="text" class="col-filter" data-col="3" placeholder="Filter Date"></th>
                    <th hidden></th>
                    <th hidden></th>
                    <th><input type="text" class="col-filter" data-col="6" placeholder="Filter Desc."></th>
                    <th><input type="text" class="col-filter" data-col="7" placeholder="Filter Long Desc."></th>
                    <th><input type="text" class="col-filter" data-col="8" placeholder="Filter Qty"></th>
                    <th><input type="text" class="col-filter" data-col="9" placeholder="Filter UOM"></th>
                </tr>
            </thead>
            <tbody id="tblbodyserv"></tbody>
        </table>
    </div>

</div>

<script>
    /* ─────────────────────────────────────────────────────────────
       SECTION 1 – unchanged helpers (row highlighting, select-all)
    ───────────────────────────────────────────────────────────── */

        function highlightRows() {
        $('.rowCheckbox:checked').closest('tr').addClass('highlighted');
        $('.rowCheckbox:not(:checked)').closest('tr').removeClass('highlighted');
    }

    function toggleButtons() {
        var fileNotEmpty      = $('#FileName')[0].files.length > 0;
        var checkboxesChecked = $('.rowCheckbox:checked').length > 0;
        $('#btnaccept, #btnmanualassign').prop('disabled', !(fileNotEmpty && checkboxesChecked));
        $('#btnrevoke').prop('disabled', !checkboxesChecked);
    }

    $('#tblbody').on('click', 'tr', function () {
        highlightRows();
    });

    var currentPage = 1;
    var totalPages  = 1;

    // $('#selectAll').change(function () {
    //     $('.rowCheckbox').prop('checked', $(this).prop('checked'));
    //     highlightRows();
    // });

    // $('.rowCheckbox').change(function () {
    //     highlightRows();
    // });

        $(document).on('change', '#selectAllMaterial', function () {

        $('#tblbody .rowCheckbox').prop('checked', this.checked);

        highlightRows();
        toggleButtons();
    });

    $(document).on('change', '#selectAllService', function () {

        $('#tblbodyserv .rowCheckbox').prop('checked', this.checked);

        highlightRows();
        toggleButtons();
    });

    $(document).on('change', '.rowCheckbox', function () {
            var visibleTable =
        $('#tblbodyserv').is(':visible')
            ? '#tblbodyserv'
            : '#tblbody';

    var total =
        $(visibleTable + ' .rowCheckbox').length;

    var checked =
        $(visibleTable + ' .rowCheckbox:checked').length;

    if (visibleTable === '#tblbody') {
        $('#selectAllMaterial').prop('checked', total > 0 && total === checked);
    } else {
        $('#selectAllService').prop('checked', total > 0 && total === checked);
    }

        highlightRows();
        toggleButtons();

    });

    function highlightRows() {
        $('.rowCheckbox:checked').closest('tr').addClass('highlighted');
        $('.rowCheckbox:not(:checked)').closest('tr').removeClass('highlighted');
    }

    $('#tblbody').on('click', 'tr', function () {
        highlightRows();
    });


    /* ─────────────────────────────────────────────────────────────
       SECTION 1B – NEW: busy overlay helpers (purely presentational,
       does not alter any request/response/business logic)
    ───────────────────────────────────────────────────────────── */
    function showBusyOverlay(message) {
        $('#page-overlay-text').text(message || 'Processing…');
        $('#page-overlay').css('display', 'flex');
    }

    function hideBusyOverlay() {
        $('#page-overlay').css('display', 'none');
    }

    function setButtonBusy($btn, busy, busyLabel) {
        if (busy) {
            if (!$btn.data('original-html')) {
                $btn.data('original-html', $btn.html());
            }
            $btn.prop('disabled', true)
                .html('<span class="btn-spinner"></span>' + (busyLabel || 'Please wait…'));
        } else {
            if ($btn.data('original-html')) {
                $btn.html($btn.data('original-html'));
            }
        }
    }

    /* ─────────────────────────────────────────────────────────────
       NEW: closing the mandatory success alert reloads the page.
       The modal uses a static backdrop + disabled keyboard dismiss
       on purpose (so the user must acknowledge it), but that also
       means Bootstrap's own dismiss handling is bypassed here —
       so the close icon / Close button explicitly trigger a full
       reload instead of just calling .modal('hide').
    ───────────────────────────────────────────────────────────── */
    $(document).on('click', '#customAlertCloseIcon, #customAlertCloseBtn', function () {
        location.reload();
    });


    /* ─────────────────────────────────────────────────────────────
       SECTION 1C – NEW: client-side table filters (visual only,
       does not touch searchData / selection / submission logic)
    ───────────────────────────────────────────────────────────── */
    function applyTableFilters($table) {
        var filters = [];
        $table.find('thead .col-filter').each(function () {
            var val = $.trim($(this).val()).toLowerCase();
            if (val) {
                filters.push({ col: parseInt($(this).data('col'), 10), val: val });
            }
        });

        var visibleCount = 0;
        $table.find('tbody tr').not('.no-results-row').each(function () {
            var $row = $(this);
            var match = true;
            $.each(filters, function (i, f) {
                var cellText = $row.find('td').eq(f.col).text().toLowerCase();
                if (cellText.indexOf(f.val) === -1) {
                    match = false;
                    return false;
                }
            });
            $row.toggle(match);
