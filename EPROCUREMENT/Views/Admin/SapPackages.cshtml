                        seR_DESC: row.find('td:eq(6)').text(), // Get Material Desc.
                        s_LON_DES: row.find('td:eq(7)').text(), // Get Material Long Desc.
                        s_REQ_QTY: row.find('td:eq(8)').text(), // Get Material requiested QTY
