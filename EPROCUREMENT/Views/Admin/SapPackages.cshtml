                                    '<td>' + row.pr + '</td>' +
                                    '<td>' + row.pR_ITEM + '</td>' +
                                    '<td>' + formattedDate + '</td>' +
                                    '<td hidden>' + row.seR_CODE + '</td>' +
                                    '<td hidden>' + row.s_GRP + '</td>' +
                                    '<td>' + row.seR_DESC + '</td>' +
                                    '<td>' + row.s_LON_DES + '</td>' +
                                    '<td>' + row.s_REQ_QTY + '</td>' +
                                    '<td>' + row.s_UNIT + '</td>' +
                                    '</tr>'
                                );
                            });

                            $('#servtble').removeAttr('hidden');
                            $('#mtrtble').attr("hidden", true);
                        }
                        else {

                            $.each(response, function (index, row) {
                                // Append each row to the table
                                // Parse the date string into a Date object
                                var reqDate = new Date(row.pR_REQ_DATE);
                                // Format the date as desired (e.g., dd-mm-yyyy)
