                }
                //formData.append('file', $('#FileName')[0].files[0]); // Add the file data to formData
                formData.append('file', fileInput.files[0]);
                // Add the file data to formData

                // Add other data to formData
                formData.append('package_name', pack_name);
                formData.append('assign_type', 'N');
                formData.append('project_id', projectId);
                formData.append('industry_id', industryId);
                // formData.append('file', $('#FileName')[0].files[0]);

                $.each(selectedRowsData, function (index, rowData) {
                    formData.append('selected_rows[' + index + '].pr', rowData.pr);
                    formData.append('selected_rows[' + index + '].pr_item', rowData.pr_item);
