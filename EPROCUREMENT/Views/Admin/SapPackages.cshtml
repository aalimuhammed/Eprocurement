    $(document).ready(function () {
        // Attach change event listener to the "Select Industry" dropdown
        var searchData = [];
        $('select[name="state"]:eq(1)').change(function () {
            // Retrieve the selected industry value
            var selectedIndustry = $(this).val();
           

            var industryId = selectedIndustry.split('|')[1];

            // Make an AJAX request to fetch data based on the selected industry
            $.ajax({
                type: 'GET',
                url: '/ServicesMaterial/GetMaterialsServices',
                data: { industry_id: industryId },
                success: function (response) {
                    searchData = response;
                    //console.log(searchData);
                },
                error: function (xhr, textStatus, errorThrown) {
                    alert('Error: ' + errorThrown);
                }
            });
        });

        function validateDropdowns() {
            var projectSelected = $('select[name="state"]:eq(0)').val() !== '';
            var industrySelected = $('select[name="state"]:eq(1)').val() !== '';

            if (!projectSelected || !industrySelected) {
                alert('Please select options in both dropdown lists.');
                return false;
            }

            return true;
        }

        function validateForm() {
            var isValid = true;

            // Check if all required fields are filled in
            $('#selectionForm :input[required]').each(function () {
                if ($.trim($(this).val()) === '') {
                    isValid = false;
                    return false; // Exit the loop if any required field is empty
                }
            });

            return isValid;
        }

        $('#btnsearch').on('click', function () { // When the search button is clicked

            if (!validateDropdowns()) {
                return;
            }

            $("input").prop('required', true);
            if (validateForm()) {
                var project = $('select[name="state"]:eq(0)').val(); // Get the selected project
                var industry = $('select[name="state"]:eq(1)').val(); // Get the selected industry
                var fromDate = $('#datefrom').val(); // Get the selected from date
                var toDate = $('#dateto').val(); // Get the selected to date


                var projectId = project.split('|')[0];

                var formattedFromDate = formatDate(fromDate);
                var formattedToDate = formatDate(toDate);

                $.ajax({
                    type: 'POST',
                    url: '/PackageDetails/Packages',
                    data: {
                        project_num: projectId,
                        datefrom: formattedFromDate,
                        dateTo: formattedToDate,
                        inudstries: searchData
                    },
                    success: function (response) {
                        // Assuming response is an array of objects containing data for each row
                        $('#tblbody').empty(); // Clear the table body
                        $('#tblbodyserv').empty();

                        if (response.length === 0) {
                            alert('No data found.');
                            return;
                        }

                        if (response[0].hasOwnProperty('seR_CODE')) {

                            $.each(response, function (index, row) {
                                // Append each row to the table
                                // Parse the date string into a Date object
                                var reqDate = new Date(row.pR_REQ_DATE);
                                // Format the date as desired (e.g., dd-mm-yyyy)
                                var formattedDate = reqDate.getDate() + '-' + (reqDate.getMonth() + 1) + '-' + reqDate.getFullYear();

                                $('#tblbodyserv').append(
