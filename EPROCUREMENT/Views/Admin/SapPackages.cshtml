    /* ─────────────────────────────────────────────────────────────
       SECTION 1E – NEW: Credit Period / Delivery Duration / Expiration
       Date field behaviour.
         • digits-only enforcement on the two number inputs
         • Expiration Date can never be set earlier than today
    ───────────────────────────────────────────────────────────── */
    $(document).ready(function () {
        // Restrict Credit Period & Delivery Duration to digits only
        $(document).on('input', '#creditPeriod, #deliveryDuration', function () {
            var cleaned = $(this).val().replace(/[^0-9]/g, '');
            $(this).val(cleaned);
        });

        // Also block non-digit keystrokes for a snappier feel (paste is still
        // sanitized by the 'input' handler above)
        $(document).on('keypress', '#creditPeriod, #deliveryDuration', function (e) {
            var charCode = e.which ? e.which : e.keyCode;
            if (charCode < 48 || charCode > 57) {
                e.preventDefault();
            }
        });

        // Expiration Date: minimum selectable date is today
        var today = new Date();
        var yyyy  = today.getFullYear();
        var mm    = String(today.getMonth() + 1).padStart(2, '0');
        var dd    = String(today.getDate()).padStart(2, '0');
        $('#expirationDate').attr('min', yyyy + '-' + mm + '-' + dd);
    });


