@model IEnumerable<EPROCUREMENT.SapResponse.PackagesResponse>;

<style>
    .highlighted {
        background-color: #ffff99; /* or any other color */
    }

    #page-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5); /* Semi-transparent background */
        z-index: 9999; /* Ensure it covers everything else */
        display: none; /* Initially hidden */
    }
</style>

<h2></h2>

<!-- Custom Modal -->
<div class="modal fade" id="customAlert" tabindex="-1" role="dialog" aria-labelledby="customAlertTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="customAlertTitle">Success</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p id="customAlertMessage" class="text-center" style="font-size: 20px;"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="alertModal" tabindex="-1" role="dialog" aria-labelledby="alertModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="alertModalLabel">Manual Assign</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <input type="text" id="searchTextBox" class="form-control" placeholder="Search by Namr Or Tax-ID">
                </div>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Vendor Name</th>
                            <th>Tax ID</th>
                            <th>Select</th>
                        </tr>
                    </thead>
                    <tbody id="searchResultsBody"></tbody>

                </table>

                <!-- Area to display selected values -->
                <h4>Selected Values</h4>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Vendor Name</th>
                            <th>Tax ID</th>
                            <th>Cancel</th>
                        </tr>
                    </thead>
                    <tbody id="selectedValues"></tbody>
                </table>


                <button type="button" id="btnrelease" class="btn btn-success">Release</button>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="page-header">
    <div class="row">
        <div class="col-md-12 col-sm-12">
            <div class="title">
                <h4>Create Packages</h4>
            </div>
        </div>
    </div>
</div>

<div class="pd-20 card-box mb-30">
    <div class="clearfix">
        <div class="pull-left">
            <h4 class="text-blue h4">Selection Criteria</h4>
        </div>
    </div>
    <form id="selectionForm">

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Select Material Group <span style="color:red">*</span></label>
                    <select class="custom-select2 form-control" id="mtrgrp" style="width: 100%; height: 38px;">
                    </select>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Select Project <span style="color:red">*</span></label>
                    <select class="custom-select2 form-control" name="state" style="width: 100%; height: 38px;">
                    </select>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label>Select Industry <span style="color:red">*</span></label>
                    <select class="custom-select2 form-control" name="state" style="width: 100%; height: 38px;" disabled>
                    </select>
                </div>
            </div>

        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Date From : <span style="color:red">*</span></label>
                    <input type="text" class="form-control date-picker" id="datefrom" placeholder="Select Date">
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label>Date To : <span style="color:red">*</span></label>
                    <input type="text" class="form-control date-picker" id="dateto" placeholder="Select Date">
                </div>
            </div>
        </div>
        <br />
        <div class="text-center">
            <!-- This div centers its content -->
            <button type="button" id="btnsearch" class="btn btn-primary">Search</button>
        </div>
    </form>
</div>

<div class="clearfix mb-20">
    <div class="pull-left">
        <h4 class="text-blue h4">Actions</h4>
    </div>
    <div class="pull-right">
       <label>
           Upload Package File
            <input type="file" id="FileName" />
       </label> 
        <button type="button" id="btnaccept" class="btn btn-success">Accept</button>
        <button type="button" id="btnrevoke" class="btn btn-danger">Revoke</button>
        <button type="button" id="btnmanualassign" class="btn btn-primary" data-toggle="modal" data-target="#alertModal">Manual Assign</button>
    </div>
</div>

<div class="pd-20 card-box mb-30" >
    <table class="table" id="mtrtble">
        <thead>
            <tr>
                <th scope="col">
                    <input type="checkbox" id="selectAll"> <!-- Checkbox for selecting all rows -->
                </th>
                <th scope="col">PR#</th>
                <th scope="col">line Item #</th>
                <th scope="col">PR requisition Date</th>
                <th hidden scope="col">Material Code</th>
                <th hidden scope="col">Material Group</th>
                <th scope="col">Material Desc.</th>
                <th scope="col">Material Long Desc.</th>
                <th scope="col">Material Batch</th>
                <th scope="col">Material requiested QTY</th>
                <th scope="col">Material UOM</th>
            </tr>
        </thead>
        <tbody id="tblbody">
        </tbody>
    </table>

    <table class="table" id="servtble" hidden>
        <thead>
            <tr>
                <th scope="col">
                    <input type="checkbox" id="selectAll"> <!-- Checkbox for selecting all rows -->
                </th>
                <th scope="col">PR#</th>
                <th scope="col">line Item #</th>
                <th scope="col">PR requisition Date</th>
                <th hidden scope="col">Service Code</th>
                <th hidden scope="col">Service Group</th>
                <th scope="col">Service Desc.</th>
                <th scope="col">Service Long Desc.</th>
                <th scope="col">Service requiested QTY</th>
                <th scope="col">Service UOM</th>
            </tr>
        </thead>
        <tbody id="tblbodyserv">
        </tbody>
    </table>
</div>

<script>
    var currentPage = 1;
    var totalPages = 1;
    $('#selectAll').change(function () {
        $('.rowCheckbox').prop('checked', $(this).prop('checked'));
        highlightRows();
    });

    // Checkbox for individual row selection
    $('.rowCheckbox').change(function () {
        highlightRows();
    });

    // Function to highlight selected rows
    function highlightRows() {
        $('.rowCheckbox:checked').closest('tr').addClass('highlighted');
        $('.rowCheckbox:not(:checked)').closest('tr').removeClass('highlighted');
    }

    $('#tblbody').on('click', 'tr', function () {
        highlightRows();
    });



    $(document).ready(function () {
        $('#btnmanualassign').on('click', function () { // When the Manual Assign button is clicked
            $('#searchTextBox').val(''); // Clear the search text box
            $('#searchResultsBody').empty();
           // fetchSearchResults(''); // Fetch search results with an empty search term
        });

        $('#searchTextBox').on('keyup', function (e) { // When a key is pressed in the search text box
            if (e.keyCode === 13) { // Check if the pressed key is Enter (key code 13)
                var searchTerm = $(this).val(); // Get the search term from the text box
                fetchSearchResults(searchTerm); // Fetch search results
            }
        });

        function fetchSearchResults(searchTerm) {
            // Make an AJAX request to fetch search results
            $.ajax({
                type: 'GET',
                url: '/Admin/Search',
                data: { searchTerm: searchTerm },
                success: function (response) {
                    $('#searchResultsBody').empty();

                    if (Array.isArray(response)) {
                        // If response is an array, iterate through each record and append them to the table
                        $.each(response, function (index, user) {
                            console.log(user);
                            $('#searchResultsBody').append('<tr><td>' + user.company + '</td><td>' + user.tax_id + '</td><td><button class="btn btn-success" value="' + user.id + '">Select</button></td></tr>');
                        });
                    } else if (response === "No Data Found") {
                        // If response is "No Data Found", display a message in the table
                        $('#searchResultsBody').html('<tr><td colspan="3">No Data Found</td></tr>');
                    } else {
                        // If response is a single object, append it to the table
                        $('#searchResultsBody').append('<tr><td>' + response.company + '</td><td>' + response.tax_id + '</td><td><button class="btn btn-success" value="' + response.id + '">Select</button></td></tr>');
                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                    alert('Error: ' + errorThrown);
                }
            });
        }

        $(document).on('click', '#searchResultsBody button', function () {
            var selectedRow = $(this).closest('tr');
            selectedRow.hide();

            var vendorName = $(this).closest('tr').find('td:first').text(); // Get the Vendor Name from the selected row
            var taxId = $(this).closest('tr').find('td:eq(1)').text(); // Get the Tax ID from the selected row

            var userId = selectedRow.find('.btn-success').val();

            //alert(userId);

            // Append the selected values to the designated area in the modal
            $('#selectedValues').append('<tr><td>' + vendorName + '</td><td>' + taxId + '</td><td hidden><input type="hidden" class="selected" value="' + userId + '"></td><td><button class="btn btn-danger cancelBtn">Cancel</button></td></tr>');
        });

        $(document).on('click', '.cancelBtn', function () {
            var canceledRow = $(this).closest('tr'); // Get the canceled row
            canceledRow.remove(); // Remove the canceled row from the selected values table

            var vendorName = canceledRow.find('td:first').text(); // Get the Vendor Name from the canceled row
            var taxId = canceledRow.find('td:eq(1)').text(); // Get the Tax ID from the canceled row

            // Find the corresponding row in the search results table and show it
            $('#searchResultsBody tr').each(function () {
                var row = $(this);
                if (row.find('td:first').text() === vendorName && row.find('td:eq(1)').text() === taxId) {
                    row.show(); // Show the canceled row
                    return false; // Exit the loop after finding the row
                }
            });
        });

    });


    $(document).ready(function () {
       // $('#btnaccept, #btnrevoke, #btnmanualassign').prop('disabled', true);
        $("input").prop('required', true);
        // Make an AJAX request to fetch projects

        $('select[name="state"]:eq(0)').append('<option value="">Please Select your Project</option>');
        $.ajax({
            type: 'GET', // Use GET method to fetch data
            url: '/Project/SapProjects', 
            success: function (response) {
                $.each(response, function (index, project) {
                    // Append each project as an option to the select element
                    $('select[name="state"]:eq(0)').append('<option value="' + project.proj_num + '|' + project.id + '">' + project.proj_name + '</option>');
                });
            },
            error: function (xhr, textStatus, errorThrown) {
                alert('Error: ' + errorThrown);
            }
        });

        // Your existing code for handling search button click and displaying table rows goes here
    });



    $(document).ready(function () {

        $('#mtrgrp').append('<option value="">Please Select your Material Group </option>');
        $.ajax({
            type: 'GET', // Use GET method to fetch data
            url: '/ViewOnly/GetMaterialsGrp',
            success: function (response) {
                $.each(response, function (index, project) {
                    // Append each project as an option to the select element
                    $('#mtrgrp').append('<option value="' + project.id + '">' + project.name + '</option>');
                });
            },
            error: function (xhr, textStatus, errorThrown) {
                alert('Error: ' + errorThrown);
            }
        });


        $('#mtrgrp').change(function () {
            var selectedValue = $(this).val();

            $('select[name="state"]:eq(1)').val('');
            $('select[name="state"]:eq(1) option[value=""]').remove();


            if (selectedValue) {
                var found = false;

                $('select[name="state"]:eq(1) option').each(function () {
                    var optionId = $(this).val().split('|')[1];
                    if (optionId === selectedValue) {
                        $('select[name="state"]:eq(1)').val($(this).val()); // Set the selected option
                        found = true;
                        return false; // Break the loop once the value is found
                    }
                });
                // Force a UI update by triggering change event
                if (found) {
                    $('select[name="state"]:eq(1)').trigger('change'); // Trigger change to refresh UI
                }
            } else {
                // Reset the second dropdown if no value is selected in the first dropdown
                $('select[name="state"]:eq(1)').val('');
            }
        });
    });


    $(document).ready(function () {
        // Make an AJAX request to fetch projects

        $('select[name="state"]:eq(1)').append('<option value="">Selected Industry</option>');
        $.ajax({
            type: 'GET', // Use GET method to fetch data
            url: '/Industry/SapIndustry',
            success: function (response) {
                $.each(response, function (index, industry) {
                    // Append each project as an option to the select element
                    $('select[name="state"]:eq(1)').append('<option value="' + industry.industry_code + '|' + industry.id + '">' + industry.descr + '</option>');
                });
            },
            error: function (xhr, textStatus, errorThrown) {
                alert('Error: ' + errorThrown);
            }
        });

        // Your existing code for handling search button click and displaying table rows goes here
    });

    $(document).ready(function () {
        // Disable the three buttons initially
        $('#btnaccept, #btnrevoke, #btnmanualassign').prop('disabled', true);

        // Function to enable or disable the buttons based on the file input and checkbox states
        function toggleButtons() {
            var fileNotEmpty = $('#FileName')[0].files.length > 0; // Check if file input is not empty
            var checkboxesChecked = $('.rowCheckbox:checked').length > 0; // Check if any checkboxes are checked

            // Enable or disable buttons based on conditions
            $('#btnaccept, #btnmanualassign').prop('disabled', !(fileNotEmpty && checkboxesChecked));
            $('#btnrevoke').prop('disabled', !checkboxesChecked);
        }

        // Event listener for file input change
        $('#FileName').on('change', function () {
            toggleButtons(); // Check button states when file input changes
        });

        // Event listener for checkbox change
        $('#tblbody').on('change', '.rowCheckbox', function () {
            toggleButtons(); // Check button states when checkboxes change
        });
    });



    $(document).ready(function () {
